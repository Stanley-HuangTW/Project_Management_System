generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  MEMBER
}

enum ColumnType {
  TEXT
  STATUS
  PERSON
  DATE
  NUMBER
}

enum BoardVisibility {
  PUBLIC
  RESTRICTED
}

/// 可見範圍 for a 分組 or a 工作項. PRIVATE keeps a row off other people's
/// screens without taking it out of the schedule — see itemVisibility.
enum RowVisibility {
  PUBLIC
  PRIVATE
}

/// A date the schedule must respect whatever the Pred chain computes.
/// START_NO_EARLIER_THAN and MUST_FINISH_ON move the item; FINISH_NO_LATER_THAN
/// is a deadline — it does not make work go faster, it reports being late.
enum ItemConstraintType {
  START_NO_EARLIER_THAN
  FINISH_NO_LATER_THAN
  MUST_FINISH_ON
}

enum GanttDurationMode {
  CALENDAR
  BUSINESS
}

// Per-Group leadership roles. TEAM_LEADER and PMD get schedule-edit rights
// across the whole group; SW_DM/HW_DM/ME_DM/QA get item-create/assign/
// progress-management rights scoped to their own discipline's GroupMember
// roster; PMM is roster-only (no extra permissions).
enum GroupRole {
  TEAM_LEADER
  SW_DM
  HW_DM
  ME_DM
  QA
  PMM
  PMD
  PM_DM
}

enum GroupDiscipline {
  SW
  HW
  ME
  QA
  PM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  avatarUrl    String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  /// 這個人自己排的側邊欄順序(看板 id、專案群組 id,由上到下)。沒在清單裡的(例如新建的)接在最後,照建立時間。
  boardOrder   String[] @default([])
  programOrder String[] @default([])
  /// 這個人自己排的儀表板區塊順序(區塊 id,由上到下)。沒在清單裡的區塊接在最後、照預設順序。
  dashboardOrder String[] @default([])
  /// 儀表板的子類(分頁):[{ id, name, sections: [區塊 id] }]。沒設定 = 只有「全部」。
  dashboardTabs Json?

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  /// 每小時人力成本(元)。null = 尚未設定,成本會照 0 算並在報表上點名。
  /// 放在使用者身上而不是設定頁:它跟著人的職級變動,不是一份全域參數。
  hourlyRate    Decimal? @db.Decimal(12, 2)
  /// 所屬單位 —— 人力成本與人力規劃都照這個歸戶。
  discipline    String?
  orgUnit       OrgUnit? @relation(fields: [discipline], references: [code], onDelete: SetNull, onUpdate: Cascade)
  /// 個人月薪。有填就蓋過所屬單位的標準月薪;時薪有填的話仍然優先,
  /// 換算順序見 labourRate.ts。
  monthlySalary Decimal? @db.Decimal(12, 2)
  /// 可以檢視全部成員的工時統計(管理員指定給個別主管)。沒勾的主管只看得到
  /// 直屬部屬,一般成員只看得到自己 —— 見 timesheet.ts 的 canViewTimesheetOf。
  /// 管理者設定:這個人登記的工時不用核准,直接生效(專案工時與對應專案的會議工時)。
  timesheetNoApproval Boolean @default(false)
  canViewAllTimesheets Boolean @default(false)

  weeklyReports WeeklyReport[]
  oauthCodes    OAuthCode[]
  oauthTokens   OAuthToken[]
  supervisorId  String?
  supervisor    User?          @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  teamMembers   User[]         @relation("Supervision")
  /// 在組織架構圖上掛在哪個部門底下。有掛的人,所屬主管(supervisorId)由架構圖算出來,不再手動指定。
  orgNodeId     String?
  orgNode       OrgNode?       @relation("OrgNodeMembers", fields: [orgNodeId], references: [id], onDelete: SetNull)
  headOfNodes   OrgNode[]      @relation("OrgNodeHead")
  approvalSteps ApprovalStep[] @relation("ApprovalStepApprover")
  orgRoles      OrgRole[]      @relation("OrgRoleUser")

  ownedBoards             Board[]
  comments                Comment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  assignments             Assignment[]
  automationNotifyFor     AutomationRule[]         @relation("RuleNotifyUser")
  boardMemberships        BoardMember[]
  budgetViewerOf          BoardBudgetViewer[]
  attachments             Attachment[]
  itemLinks               ItemLink[]
  activityLogEntries      ActivityLogEntry[]
  createdItems            Item[]                   @relation("ItemCreatedBy")
  deletedItems            Item[]                   @relation("ItemDeletedBy")
  deletedBoards           Board[]                  @relation("BoardDeletedBy")
  labourSlots             LabourSlot[]             @relation("LabourSlotOwner")
  savedViews              SavedView[]              @relation("SavedViewOwner")
  projectTemplates        ProjectTemplate[]        @relation("ProjectTemplateCreatedBy")
  timeEntries             TimeEntry[]
  activityTimeEntries     ActivityTimeEntry[]
  timeTemplates           TimeTemplate[]
  ownedRisks              RiskEntry[]              @relation("RiskOwner")
  riskReviews             RiskReviewer[]           @relation("RiskReviewer")
  riskUpdates             RiskUpdate[]             @relation("RiskUpdateAuthor")
  visibleItems            ItemViewer[]
  leaves                  Leave[]
  visibleGroups           GroupViewer[]
  apiKeys                 ApiKey[]                 @relation("ApiKeyOwner")
  feedback                UserFeedback[]           @relation("UserFeedbackAuthor")
  managedResources        Resource[]               @relation("ResourceManager")
  groupRoleAssignments    GroupRoleAssignment[]    @relation("GroupRoleAssignments")
  groupMemberships        GroupMember[]            @relation("GroupMembers")
  gateApprovals           GateApprover[]
  requestedChanges        ChangeRequest[]          @relation("ChangeRequester")
  decidedChanges          ChangeRequest[]          @relation("ChangeDecider")
  decidedTimeEntries      TimeEntry[]              @relation("TimeEntryDecider")
  decidedLeaves           Leave[]                  @relation("LeaveDecider")
  reserveDraws            ReserveDraw[]            @relation("ReserveDrawDecider")
  gateDecisions           Gate[]                   @relation("GateDecidedBy")
  reportRecipientFor      ProgramReportRecipient[]
  chatMemberships         ChatMember[]
  chatMessages            ChatMessage[]
  boardRoleAssignments    BoardRoleAssignment[]    @relation("BoardRoleAssignments")
  boardDisciplineMembers  BoardDisciplineMember[]  @relation("BoardDisciplineMembers")
  bomAttachments          BomAttachment[]          @relation("BomAttachmentUploader")
}

// A non-login entity (tool, equipment, external vendor/supplier) that can be
// set as an item's 負責人 (PERSON column) alongside real Users, so tasks
// depending on them still have an accountable owner. Deliberately excluded
// from dashboards, workload calculations, and notifications, which only
// make sense for real staff.
model Resource {
  id        String   @id @default(cuid())
  name      String
  category  String?
  contact   String?
  note      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  managerId String?
  manager   User?   @relation("ResourceManager", fields: [managerId], references: [id], onDelete: SetNull)

  groupMemberships GroupResourceMember[]
  boardMemberships BoardResourceMember[]
}

model Board {
  id         String          @id @default(cuid())
  name       String
  ownerId    String
  owner      User            @relation(fields: [ownerId], references: [id])
  createdAt  DateTime        @default(now())
  visibility BoardVisibility @default(PUBLIC)

  progressColumnId String?
  progressColumn   Column? @relation("BoardProgressColumn", fields: [progressColumnId], references: [id], onDelete: SetNull)

  ganttStartColumnId    String?
  ganttStartColumn      Column?           @relation("BoardGanttStartColumn", fields: [ganttStartColumnId], references: [id], onDelete: SetNull)
  ganttDurationColumnId String?
  ganttDurationColumn   Column?           @relation("BoardGanttDurationColumn", fields: [ganttDurationColumnId], references: [id], onDelete: SetNull)
  ganttEndColumnId      String?
  ganttEndColumn        Column?           @relation("BoardGanttEndColumn", fields: [ganttEndColumnId], references: [id], onDelete: SetNull)
  ganttDurationMode     GanttDurationMode @default(CALENDAR)

  predColumnId String?
  predColumn   Column? @relation("BoardPredColumn", fields: [predColumnId], references: [id], onDelete: SetNull)
  linkColumnId String?
  linkColumn   Column? @relation("BoardLinkColumn", fields: [linkColumnId], references: [id], onDelete: SetNull)
  lagColumnId  String?
  lagColumn    Column? @relation("BoardLagColumn", fields: [lagColumnId], references: [id], onDelete: SetNull)
  typeColumnId String?
  typeColumn   Column? @relation("BoardTypeColumn", fields: [typeColumnId], references: [id], onDelete: SetNull)
  priorityColumnId String?
  priorityColumn   Column? @relation("BoardPriorityColumn", fields: [priorityColumnId], references: [id], onDelete: SetNull)

  // When both are set, Start/Days/Finish become read-only and are always
  // computed from these + Pred/Link/Lag — see resolveLockedScheduleFields.
  manualStartColumnId    String?
  manualStartColumn      Column? @relation("BoardManualStartColumn", fields: [manualStartColumnId], references: [id], onDelete: SetNull)
  manualDurationColumnId String?
  manualDurationColumn   Column? @relation("BoardManualDurationColumn", fields: [manualDurationColumnId], references: [id], onDelete: SetNull)

  reportStatusColumnId      String?
  reportStatusColumn        Column?  @relation("BoardReportStatusColumn", fields: [reportStatusColumnId], references: [id], onDelete: SetNull)
  reportNotStartedOptionIds String[] @default([])
  reportPlannedOptionIds    String[] @default([])
  reportPausedOptionIds     String[] @default([])
  reportStuckOptionIds      String[] @default([])
  reportDoneOptionIds       String[] @default([])

  levelColors String[] @default([])

  // Gantt task-name colors — app-wide (see SystemSettings), mirrored here on
  // write for the same reason levelColors is. Priority when an item matches
  // more than one: 完成 (done) beats 逾期 (overdue) beats 實作中 (in
  // progress); 尚未處理 (not started) gets no override, just the theme's
  // normal text color.
  ganttOverdueColor    String @default("#e2445c")
  ganttCompletedColor  String @default("#9ca3af")
  ganttInProgressColor String @default("#00c875")
  /// 暫停(報表分類裡歸在「暫停」的狀態)的項目名稱顏色;優先於逾期。
  ganttPausedColor     String @default("#fdab3d")

  /// Pred lamp: predecessor done / still running / overdue.
  predReadyColor   String @default("#00c875")
  predWaitingColor String @default("#fdab3d")
  predBlockedColor String @default("#e2445c")

  /// When this board's baseline was last captured — null means it has none,
  /// so nothing is compared against a plan that was never saved.
  baselineCapturedAt DateTime?

  /// 垃圾桶。刪除看板不再是真的刪掉:有 deletedAt 的看板從每一份清單、搜尋、
  /// 排程網路與專案群組的計算裡消失,但整份資料都還在,可以還原。只有管理者
  /// 能永久刪除。
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("BoardDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  groups          Group[]
  columns         Column[]         @relation("BoardColumns")
  items           Item[]
  automationRules AutomationRule[]
  members         BoardMember[]
  budgetViewers   BoardBudgetViewer[]
  /// 專案群組:同一個群組裡的看板共用一張排程網路,前置可以跨看板,
  /// 要徑與完工日也是整個群組一起算。null = 這個看板自成一個專案。
  programId       String?
  program         Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)

  savedViews     SavedView[]
  risks          RiskEntry[]
  gates          Gate[]
  changeRequests ChangeRequest[]
  activityLog    ActivityLogEntry[]
  webhooks       Webhook[]
  baselines      Baseline[]
  budgetPhases   BudgetPhase[]
  planMilestones PlanMilestone[]
  milestoneTypes MilestoneType[]
  labourSlots    LabourSlot[]
  protoPlans     ProtoPlan[]
  protoUnits     ProtoUnit[]
  protoRowOrders ProtoRowOrder[]
  bomLines       BomLine[]
  budgetProducts BudgetProduct[]
  nreLines       NreLine[]

  @@index([deletedAt])
  activityTimeEntries ActivityTimeEntry[]
  timeTemplates       TimeTemplate[]
  mantisConnection    MantisConnection?
  chatConversation    ChatConversation?
  roleAssignments     BoardRoleAssignment[]
  disciplineMembers   BoardDisciplineMember[]
  resourceMembers     BoardResourceMember[]
  /// 這個看板 BOM 的欄位設定(有順序的清單:欄位、類型、必填、預設值;格式見 src/lib/bomColumns.ts)。
  /// null = 沒有自己設定,沿用 SystemSettings.bomDefaultColumns(系統預設也沒設就是內建的)。
  bomColumns          Json?
  bomAttachments      BomAttachment[]
}

/// 這塊看板指名「可以看預算金額」的人(看板分享設定);管理者、擁有者、Team Leader / PMD / PM DM 本來就看得到,不用列在這裡。
model BoardBudgetViewer {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

model BoardMember {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

model Group {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String @default("#579bfc")
  order   Int    @default(0)

  visibility  RowVisibility @default(PUBLIC)
  viewers     GroupViewer[]
  /// Who made it private, and therefore keeps sight of it.
  createdById String?

  items                 Item[]
  automationMoveTargets AutomationRule[]
  /// 這個分組「自己設定」的角色(不沿用看板的)。有列在這裡的角色,名單以分組自己的為準,看板改了也不動它;
  /// 沒列的角色,名單就是看板角色(BoardRoleAssignment)的複本,由 boardRolesServer 負責同步。
  roleOverrides         GroupRole[]           @default([])
  roleAssignments       GroupRoleAssignment[]
  members               GroupMember[]
  resourceMembers       GroupResourceMember[]
  /// 這個分組「自己設定」實作成員的職能(不沿用看板的)。規則跟 roleOverrides 一樣:有列的職能以分組自己的名單為準,
  /// 沒列的職能,GroupMember 就是看板實作成員(BoardDisciplineMember)的複本,由 boardRolesServer 同步。
  memberOverrides       GroupDiscipline[]     @default([])
  /// true = 這個分組自己設定 Resource 成員;false = GroupResourceMember 是看板 Resource 成員(BoardResourceMember)的複本。
  resourceOverride      Boolean               @default(false)

  @@index([boardId])
}

/// 看板層級的角色:每個分組預設沿用這裡的名單(分組可以逐一角色改成自己的,見 Group.roleOverrides)。
/// 實際生效的權限仍然讀 GroupRoleAssignment——沒有自己設定的角色,那裡的列就是這裡的複本。
model BoardRoleAssignment {
  id      String    @id @default(cuid())
  boardId String
  board   Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  role    GroupRole
  userId  String
  user    User      @relation("BoardRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, role, userId])
  @@index([userId])
}

/// 看板層級的實作成員(SW/EE/ME/QA/PM 各職能):每個分組預設沿用這裡的名單(分組可以逐一職能改成自己的,見 Group.memberOverrides)。
/// 實際生效的權限仍然讀 GroupMember——沒有自己設定的職能,那裡的列就是這裡的複本。
model BoardDisciplineMember {
  id         String          @id @default(cuid())
  boardId    String
  board      Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  discipline GroupDiscipline
  userId     String
  user       User            @relation("BoardDisciplineMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, discipline, userId])
  @@index([userId])
}

/// 看板層級的 Resource 成員(花名冊):分組預設沿用(分組自己設定時 Group.resourceOverride = true)。
model BoardResourceMember {
  id         String   @id @default(cuid())
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([boardId, resourceId])
  @@index([resourceId])
}

// A user holding TEAM_LEADER or PMD for a Group can edit the schedule
// (Start/Days/Finish, Gantt drag) of any item in that group, regardless of
// their board-wide UserRole or item assignment — see canEditGanttItem's
// `hasGroupScheduleRole` param. SW_DM/HW_DM/ME_DM/QA instead act as a
// discipline-scoped supervisor (see GroupMember) with no schedule rights.
model GroupRoleAssignment {
  id      String    @id @default(cuid())
  groupId String
  group   Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role    GroupRole
  userId  String
  user    User      @relation("GroupRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, role, userId])
  @@index([groupId, userId])
}

// The roster of users actually doing SW/HW/ME/QA work in a Group — this is
// what a matching discipline DM (see GroupRoleAssignment) is scoped to
// manage: item creation/assignment/progress for items assigned to these
// users, within this group only.
model GroupMember {
  id         String          @id @default(cuid())
  groupId    String
  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  discipline GroupDiscipline
  userId     String
  user       User            @relation("GroupMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, discipline, userId])
}

// Resources (tools/vendors, no login) rostered to a Group — informational
// only, mirrors GroupMember but grants no permissions since Resources can't
// authenticate.
model GroupResourceMember {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([groupId, resourceId])
}

model Column {
  id      String     @id @default(cuid())
  boardId String
  board   Board      @relation("BoardColumns", fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  type    ColumnType
  options Json       @default("{}")
  order   Int        @default(0)

  cellValues              CellValue[]
  progressForBoards       Board[]          @relation("BoardProgressColumn")
  ganttStartForBoards     Board[]          @relation("BoardGanttStartColumn")
  ganttDurationForBoards  Board[]          @relation("BoardGanttDurationColumn")
  ganttEndForBoards       Board[]          @relation("BoardGanttEndColumn")
  predForBoards           Board[]          @relation("BoardPredColumn")
  linkForBoards           Board[]          @relation("BoardLinkColumn")
  lagForBoards            Board[]          @relation("BoardLagColumn")
  typeForBoards           Board[]          @relation("BoardTypeColumn")
  priorityForBoards       Board[]          @relation("BoardPriorityColumn")
  reportStatusForBoards   Board[]          @relation("BoardReportStatusColumn")
  manualStartForBoards    Board[]          @relation("BoardManualStartColumn")
  manualDurationForBoards Board[]          @relation("BoardManualDurationColumn")
  ruleTriggersFor         AutomationRule[] @relation("RuleTriggerColumn")
  ruleSetsFor             AutomationRule[] @relation("RuleSetColumn")

  @@index([boardId])
}

model Item {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Item?    @relation("ItemSubitems", fields: [parentId], references: [id], onDelete: Cascade)
  subitems  Item[]   @relation("ItemSubitems")
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  constraintType ItemConstraintType?
  /// "YYYY-MM-DD", meaningless without a constraintType.
  constraintDate String?

  /// The saved plan this item is measured against — copied from its current
  /// Start/Finish/Days when the board's baseline is captured, then left alone
  /// while the real dates move. Null until a baseline exists.
  baselineStart String?
  baselineEnd   String?
  baselineDays  Int?

  /// 直接費用(NRE、BOM、外包…),與人力成本分開記:一個是買來的,一個是
  /// 做出來的,混在一起就分不出超支的是料還是工。
  ///
  /// 整數元,不是 Decimal:這兩個值會跟著 board.items 一路傳到 client
  /// component,而 Decimal 是類別實例、過不了那個邊界;報價本來也都是整數元。
  budgetCost Int?
  actualCost Int?

  /// The Type option this item had before gaining its first child forced it
  /// to Summary, so removing the last child can put it back. "" means it had
  /// no Type at all; null means it was never flipped.
  typeBeforeSummary String?

  visibility RowVisibility @default(PUBLIC)
  viewers    ItemViewer[]

  createdById String?
  createdBy   User?   @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Set when the item is put in the trash. Every read path filters on
  /// deletedAt: null — a trashed item is gone from the board, the schedule
  /// and every report, but its comments, files and history are still there
  /// waiting for a restore.
  deletedAt           DateTime?
  deletedById         String?
  deletedBy           User?     @relation("ItemDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  /// What the dependents' Pred cells held before this deletion rewrote them,
  /// as [{itemId, columnId, value}] — restoring the item has to put their
  /// dependencies back too, or the undo is only half an undo.
  deletedPredSnapshot Json?

  cellValues    CellValue[]
  comments      Comment[]
  notifications Notification[]
  assignments   Assignment[]
  /// 「使用樣機」:這個工作項(例如測試項目)用到的樣機。
  protoUnits    ItemProtoUnit[]
  attachments   Attachment[]
  links         ItemLink[]
  activityLog   ActivityLogEntry[]
  todoItems     TodoItem[]
  timeEntries   TimeEntry[]
  timeTemplates TimeTemplate[]
  budgets       Budget[]
  commitments   Commitment[]
  expenses      Expense[]
  reserves      Reserve[]

  @@index([boardId])
  @@index([groupId])
  @@index([parentId])
  @@index([boardId, deletedAt])
}

model Attachment {
  id           String      @id @default(cuid())
  /// Always set, even for a receipt attached to an expense: it is what the
  /// download route checks board access through, and where the file is
  /// stored on disk.
  itemId       String
  item         Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 報價單、發票、簽了的 PO。設了其中一個,這個檔案就是那筆帳的憑證,
  /// 而不是工作項本身的附件——項目卡片的附件清單會把它們排除。
  expenseId    String?
  expense      Expense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  commitmentId String?
  commitment   Commitment? @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  fileName     String
  url          String
  size         Int
  uploaderId   String
  uploader     User        @relation(fields: [uploaderId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([itemId])
  @@index([expenseId])
  @@index([commitmentId])
}

/// 工作項底下的外部連結(雲端硬碟、Google Sheet、外部文件……)——跟附件是
/// 兩回事:附件是上傳進系統的檔案本體,這裡存的只是網址,不佔儲存空間。
model ItemLink {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url         String
  /// 使用者自己取的顯示名稱。沒填就顯示網址本身。
  label       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  /// 這個連結要不要彙整進週報(預設要)。
  inWeeklyReport Boolean @default(true)

  @@index([itemId])
}

/// 稽核事件的分類。工作項的改動是原本就有的那一類;其餘是這次補上的——
/// 費率、基準線、可見範圍、看板刪除這些「管錢跟管承諾」的操作,以前反而
/// 一筆都沒留。
enum AuditCategory {
  ITEM
  BOARD
  BASELINE
  VISIBILITY
  /// 費率與預算。
  COST
  SETTINGS
  /// 帳號、角色、分組權限。
  ACCESS
  GATE
  CHANGE
  /// 工時與請假的審核。
  APPROVAL
  /// 風險與議題的建立、修改、進度更新與結案審核。
  RISK
}

model ActivityLogEntry {
  id        String        @id @default(cuid())
  /// 工作項層級的事件。板級/系統級事件沒有工作項,所以可為 null。
  itemId    String?
  item      Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 事件屬於哪個看板。工作項事件也填,這樣稽核頁不必為了篩選看板而回頭
  /// 查每一筆的工作項。系統層級的事件為 null。
  boardId   String?
  board     Board?        @relation(fields: [boardId], references: [id], onDelete: SetNull)
  /// 風險與議題層級的事件(建立、改欄位、申請結案、審核)。風險被刪掉時紀錄一起清掉,
  /// 「誰刪了它」另外記一筆沒有 riskId 的板級稽核。
  riskId    String?
  risk      RiskEntry?    @relation(fields: [riskId], references: [id], onDelete: Cascade)
  category  AuditCategory @default(ITEM)
  actorId   String?
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  message   String
  createdAt DateTime      @default(now())
  /// 工作項事件的種類:STATUS 狀態切換、UPDATE 更新(留言)、LINK 連結、TODO 待辦事項、FIELD 其他欄位。
  /// 給「更新記錄」欄、本週完成與週報用,不必去解析上面那句中文。比較舊的紀錄沒有,遷移時從訊息文字補了。
  eventKind   String?
  /// 狀態切換:切到的是進行中(inProgress)、完成(done)還是其他(other),以及切到的選項標籤。
  statusKind  String?
  statusLabel String?
  /// 這筆紀錄要不要彙整進週報(預設要)。待辦事項的紀錄跟著那個待辦事項的旗標;其他種類永遠是 true。
  inWeeklyReport Boolean @default(true)
  /// 待辦事項的紀錄對到哪一個待辦事項(沒有外鍵:待辦事項刪掉,紀錄還在)。
  todoItemId     String?

  @@index([itemId])
  @@index([riskId])
  @@index([boardId, createdAt])
  @@index([boardId, eventKind, createdAt])
  @@index([category, createdAt])
}

model TodoItem {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  /// 這個待辦事項的新增與完成要不要彙整進週報(預設要)。週報讀的是活動紀錄,改這個旗標時 todoItemId 對得上的紀錄一起改。
  inWeeklyReport Boolean @default(true)
  /// 期限("YYYY-MM-DD",台北的日曆日)。null = 沒設期限。有設而且還沒完成的,到期前一天、當天、逾期後各提醒一次。
  dueDate   String?
  /// 提醒到哪一階段了:0 = 還沒提醒、1 = 已提醒「明天到期」、2 = 已提醒「今天到期」、3 = 已提醒「已逾期」。
  /// 改期限時歸零,重新照新的期限提醒。
  remindedStage Int @default(0)
  /// 誰新增的待辦事項(提醒的收件人除了項目的負責人,也包含寫這一筆的人)。舊資料是 null。
  createdById String?
  /// 處理者:這個待辦事項要由誰完成。預設是工作項的負責人;沒有負責人就取人員分配 / 工時比例最高的人;
  /// 從對話轉過來、訊息裡有 @ 誰,就是那個人(見 todoAssignee)。有設的話,期限提醒給他(加上新增的人),null = 沒指定。
  assigneeId String?
  /// 備註:讓使用者記錄這個待辦事項的處理狀態、結果。null = 沒有備註。
  note      String?

  @@index([itemId])
  @@index([dueDate])
  @@index([assigneeId])
}

model Assignment {
  id            String @id @default(cuid())
  itemId        String
  item          Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocationPct Int    @default(100)

  @@unique([itemId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
  /// 這則更新要不要彙整進週報(預設要)。
  inWeeklyReport Boolean @default(true)

  @@index([itemId])
}

enum NotificationType {
  ASSIGNED
  UPDATED
  COMMENTED
  AUTOMATION
  /// 新增與刪除一列。收件人比其他幾種廣:同一個分組的人都會收到,因為
  /// 結構變動影響的是整張排程網路,不只被指派的那個人。
  CREATED
  DELETED
  /// 待辦事項的期限提醒(到期前一天、當天、逾期)。
  DEADLINE
  /// 對話:被 @ 提到、收到私訊或群組新訊息。
  CHAT
  /// 簽核:有東西等你簽(請假、工時、閘門、變更單、風險 / 議題結案),或你送出的簽核有結果了。
  APPROVAL
}

model AutomationRule {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String

  triggerColumnId String
  triggerColumn   Column @relation("RuleTriggerColumn", fields: [triggerColumnId], references: [id], onDelete: Cascade)
  triggerValue    String

  notifyUserId String?
  notifyUser   User?   @relation("RuleNotifyUser", fields: [notifyUserId], references: [id], onDelete: SetNull)

  setColumnId String?
  setColumn   Column? @relation("RuleSetColumn", fields: [setColumnId], references: [id], onDelete: SetNull)
  setValue    Json?

  moveToGroupId String?
  moveToGroup   Group?  @relation(fields: [moveToGroupId], references: [id], onDelete: SetNull)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  type      NotificationType
  /// 工作項的通知。風險/問題被指派的通知沒有工作項,是下面的 riskId——兩個至少有一個。
  itemId    String?
  item      Item?            @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 風險/問題(含 Mantis 同步來的)被指派為負責人或審核人的通知。
  riskId    String?
  risk      RiskEntry?       @relation(fields: [riskId], references: [id], onDelete: Cascade)
  /// 對話的通知(被 @ 提到、收到私訊)沒有工作項也沒有風險,指到那個對話。
  conversationId String?
  conversation   ChatConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message   String
  /// 沒有工作項 / 風險 / 對話可指的通知(例如待簽核的請假)點下去要去的站內路徑。
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([itemId])
  @@index([riskId])
  @@index([conversationId])
}

/// 一個人對某一種通知類型的偏好——站內要不要收、email 要不要寄。沒有這筆
/// 紀錄代表還沒特別設定過,各類型各自的預設值在 notify.ts 的
/// DEFAULT_IN_APP / DEFAULT_EMAIL 裡,跟改這個功能之前的既有行為一致。
model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  inApp     Boolean          @default(true)
  email     Boolean          @default(false)
  updatedAt DateTime         @updatedAt

  @@unique([userId, type])
}

model WorkloadThreshold {
  id          String   @id @default("global")
  greenMax    Int      @default(30)
  yellowMax   Int      @default(70)
  greenColor  String   @default("#00c875")
  yellowColor String   @default("#fdab3d")
  redColor    String   @default("#e2445c")
  updatedAt   DateTime @updatedAt
}

// App-wide settings an ADMIN controls from /settings. Defaults to email
// notifications OFF — the site isn't public yet and nobody should get an
// email until an admin deliberately turns it on. levelColors/
// ganttDurationMode used to be per-Board fields; they're app-wide now, so a
// write here also broadcasts to every Board's own copy of the field (kept
// only so the many existing per-board reads don't need to change).
/// 預算表自己的一組階段起訖日。
///
/// 刻意跟看板上那幾列階段的 Start/Finish 分開:預算表是初期評估,做的時候
/// 實際時程還不存在,之後也一定會有落差 —— 而那個落差正是要看的東西。
/// itemId 對上看板那一列之後,就比得出「當初排幾天 vs 現在要幾天」。
model BudgetPhase {
  id        String  @id @default(cuid())
  boardId   String
  board     Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  /// "YYYY-MM-DD"。
  startDate String
  endDate   String
  /// 對應到看板上的哪一列階段。null = 純預算階段,不比較時程。
  itemId    String?
  /// 帶的顏色。同色的話,兩個相鄰的階段在時間軸上會糊成一條。
  color     String  @default("#fdab3d")
  order     Int

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  protoPlans  ProtoPlan[]
  protoUnits  ProtoUnit[]
  budgets     Budget[]
  reserves    Reserve[]
  labourPlans LabourPlan[]
  bomLines    BomLine[]
  nreLines    NreLine[]

  @@index([boardId, order])
}

/// 里程碑區間:軟體、硬體 PCBA 打件、機構出圖、認證、測試、demo 樣機……
/// 有起也有迄,所以是一條帶,不是看板上 Type=Milestone 那種單一日期的點。
/// track 讓它們分列排,就像那張 Excel 的「SW milestones」「Key Milestone」兩列。
/// 里程碑類型,例如「軟體」「機構」「key part 備料」。
///
/// 同一個類型的里程碑排在同一排 —— 類型就是那一排的名字。每塊看板自己一
/// 份:M3 的「key part 備料」跟充電站的不是同一件事。
model MilestoneType {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  order   Int

  milestones PlanMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, name])
  @@index([boardId, order])
}

model PlanMilestone {
  id        String        @id @default(cuid())
  boardId   String
  board     Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 排在哪一排。類型底下的里程碑彼此重疊才會再往下長。
  typeId    String
  type      MilestoneType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  name      String
  startDate String
  endDate   String
  color     String        @default("#fdab3d")
  order     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, typeId, order])
}

/// 一個人力名額,也就是那張 Excel 裡的一列(EE1、SW3、ME2……)。
///
/// 名額而不是人:預算階段常常還沒招到人,那一列就掛 TBH。指到人之後,
/// userId 有值,ownerLabel 留著寫「TBH (Jason 代)」這種註記。
model LabourSlot {
  id          String  @id @default(cuid())
  boardId     String
  board       Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  discipline  String
  orgUnit     OrgUnit @relation(fields: [discipline], references: [code], onDelete: Restrict, onUpdate: Cascade)
  /// 名額代號,EE1、SW3。
  label       String
  /// 職能,EEDM、driver、web、PQA……比單位細一層。
  func        String  @default("")
  /// 指定的人。null = 還沒指定。
  userId      String?
  user        User?   @relation("LabourSlotOwner", fields: [userId], references: [id], onDelete: SetNull)
  /// 沒指定人時寫在負責人欄的字,例如「TBH」「TBH (Jason 代)」。
  ownerLabel  String  @default("")
  description String  @default("")
  order       Int

  months LabourSlotMonth[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boardId, order])
}

/// 某個名額某個月投入多少 —— 1 = 整個月全職,0.5 = 半個月。加總就是人月。
model LabourSlotMonth {
  id     String     @id @default(cuid())
  slotId String
  slot   LabourSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  /// "YYYY-MM"。
  month  String
  fte    Decimal    @db.Decimal(5, 2)

  @@unique([slotId, month])
}

/// 樣機使用計畫:某個產品、某個階段、某個用途單位,要用掉幾台。
///
/// 跟人力表同一個道理 —— EVT 兩台給 SW 做 mock up、DVT1 三台給 QA-Rel,
/// 這些數字談出來之後才知道要備多少料。用途單位比人力的 OrgUnit 廣:
/// field test、sale department、marketing、工廠 golden sample 都會吃樣機,
/// 但那些不是工程單位,所以是自由文字而不是列舉。
model ProtoPlan {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 哪個產品。同一個看板可能同時排 M3 與充電站兩套。
  product String
  /// 用途單位,例如 HW-EE、SW、QA-Rel、Field test - US、Factory。
  unit    String
  /// 對應到 BudgetPhase 那一列。階段一刪,它的樣機數也跟著走。
  phaseId String
  phase   BudgetPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  /// 幾台。
  qty     Int
  /// 備註,例如「mock up」。
  note    String      @default("")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([boardId, product, unit, phaseId])
  @@index([boardId, product])
}

/// 樣機計畫表上某個產品的某個用途單位那一列排第幾:使用者拖曳排過才有。
/// 沒有紀錄的列(之後才新增、匯入的)排在有紀錄的後面,維持建立先後。用途單位改名、產品改名時一起改。
model ProtoRowOrder {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  product String
  unit    String
  order   Int

  @@unique([boardId, product, unit])
}

/// 樣機計畫排出來的「每一台樣機」:ProtoPlan 一格寫「M3 / SW / EVT1 要 3 台」,這裡就有 3 筆(第 1、2、3 台)。
///
/// 是樣機計畫的衍生資料,不是另外維護的清單:台數改了就跟著增減(syncProtoUnits),增加時補上、
/// 減少時從最大的號碼開始拿掉。工作項的「使用樣機」參照它;一台樣機被拿掉,參照它的那一筆跟著刪除(連帶刪除),
/// 不擋台數的修改。product / unit / phase 跟 ProtoPlan 同一組值,產品改名時兩邊一起改。
model ProtoUnit {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  product String
  unit    String
  phaseId String
  phase   BudgetPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  /// 第幾台,從 1 開始。
  seq     Int

  createdAt DateTime        @default(now())
  items     ItemProtoUnit[]

  @@unique([boardId, product, unit, phaseId, seq])
  @@index([boardId])
}

/// 工作項「使用樣機」:哪個工作項用到哪一台樣機(一個測試項目可以用好幾台)。
model ItemProtoUnit {
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  protoUnitId String
  protoUnit   ProtoUnit @relation(fields: [protoUnitId], references: [id], onDelete: Cascade)
  /// 這個工作項佔用這台樣機的百分比(預設 100%,跟人員分配的百分比同一個意思)。儀表板的樣機使用時程用它。
  usagePct    Int       @default(100)
  createdAt   DateTime  @default(now())

  @@id([itemId, protoUnitId])
  @@index([protoUnitId])
}

/// 看板的產品清單(樣機計畫與樣機 BOM 共用)。
///
/// 產品原本只是樣機計畫、BOM 每一列上的一個名字,沒有任何一列用到它就不存在,所以「先新增一個產品、
/// 再慢慢填 BOM」做不到,刪掉一個產品也要一列一列刪。這張表讓產品可以單獨存在;
/// 清單上看到的產品是它、樣機計畫與 BOM 裡用到的名字三者的聯集。
model BudgetProduct {
  id          String   @id @default(cuid())
  boardId     String
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name        String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([boardId, name])
}

/// 樣機 BOM:某個產品、某個階段,一台裝置要用哪些料。
///
/// 一個階段一份,不是一張表標三個階段的價錢 —— EVT 用的是工程樣品,DVT
/// 換成量產件,PVT 又不一樣,同一個位置在三個階段可能是三個料號、三個廠商、
/// 三個價錢。硬塞成一張表就沒辦法回答「DVT 那一版貴在哪裡」。
///
/// 多層:一列可以是「子集」(電池模組、主機板),底下再掛它自己的零件。
/// 有子項目的那一列不填單價 —— 它的價錢是底下加起來的,兩邊都填就會有
/// 一個永遠對不起來的數字,而且沒人知道該信哪一個。
model BomLine {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 哪個產品。跟樣機計畫同一組名字(M3、充電站)。
  product String
  /// 哪個階段。階段一刪,它的 BOM 也跟著走。
  phaseId String
  phase   BudgetPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  /// 上一層的子集。null = 最上層。
  parentId String?
  parent   BomLine?  @relation("BomTree", fields: [parentId], references: [id], onDelete: Cascade)
  children BomLine[] @relation("BomTree")

  /// 品名。
  name         String
  /// 廠商。
  vendor       String  @default("")
  /// 型號 / 料號。
  partNumber   String  @default("")
  /// 上一層要用幾個。最上層就是一台裝置要幾個;在子集底下就是那個子集裡要幾個。
  qty          Decimal @db.Decimal(12, 3)
  /// 單價,幣別由 currency 決定。有子項目的列填了也不算 —— 價錢從底下加上來。
  unitPrice    Decimal @db.Decimal(14, 4)
  currency     String  @default("TWD")
  /// 換算台幣的匯率,凍結在填的當下 —— 跟訂單同一個道理,事後匯率變了不該
  /// 讓半年前談好的那顆零件變貴。
  fxRate       Decimal @db.Decimal(12, 6)
  note         String  @default("")
  /// 預估交期,不影響金額計算,只是排期用。沒填就是還不知道。
  deliveryDate String? // "YYYY-MM-DD"
  /// 自訂欄位的值:{ 欄位代號: 值 }。內建欄位(廠商、型號、交期、備註)仍在上面各自的欄位裡。
  extra        Json    @default("{}")
  order        Int

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attachments BomAttachment[]

  @@index([boardId, product, phaseId, order])
  @@index([parentId])
}

/// BOM 某一列在某個「檔案附件」欄位上的檔案(規格書、報價單、承認書……)。
/// 檔案本體寫在 public/uploads/bom/<看板>/ 底下(跟其他附件同一個磁碟區,備份一併帶走),
/// 下載走 /api/bom-attachments/<id>,先查看板權限與預算可見範圍(BOM 有單價,看不到預算金額的人不能下載)。
/// columnId 是看板 BOM 欄位設定(Board.bomColumns)裡那個欄位的代號,不是資料表的外鍵。
model BomAttachment {
  id         String   @id @default(cuid())
  boardId    String
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  bomLineId  String
  bomLine    BomLine  @relation(fields: [bomLineId], references: [id], onDelete: Cascade)
  columnId   String
  fileName   String
  /// 相對於 public/ 的路徑,例如 /uploads/bom/<看板>/<時間>-<亂數>-<檔名>。
  url        String
  size       Int
  uploaderId String
  uploader   User     @relation("BomAttachmentUploader", fields: [uploaderId], references: [id])
  createdAt  DateTime @default(now())

  @@index([bomLineId, columnId])
  @@index([boardId])
}

/// 公司組織單位。人力成本、人力預算、樣機用途都按這個分,因為「這個階段
/// 要花多少錢」在 NPI 裡實際上是「EE 幾個人月、ME 幾個人月」談出來的。
///
/// 是資料表而不是列舉:公司會新增單位(FAE、NPI、Sourcing……),那是設定,
/// 不該每次都要改 schema。code 是代號(EE),label 是顯示用的全名。
model OrgUnit {
  code  String @id
  label String
  /// 排序。表格的欄位順序、下拉選單的順序都照這個。
  order Int    @default(0)

  users User[]
  /// 對應到組織架構圖的哪些部門。
  orgNodes OrgNodeUnit[]
  rate  DisciplineRate?
  plans LabourPlan[]
  slots LabourSlot[]

  @@index([order])
}

/// 各單位的標準月薪。編預算的時候還不知道會是誰做,所以人力規劃一律用
/// 單位的標準價;實際成本才用到人身上的費率。
model DisciplineRate {
  discipline    String   @id
  orgUnit       OrgUnit  @relation(fields: [discipline], references: [code], onDelete: Restrict, onUpdate: Cascade)
  /// 元/月。
  monthlySalary Int
  updatedAt     DateTime @updatedAt
}

/// 各職能的 DM 可以看到的範圍。DM(SW DM、HW DM、ME DM、QA、PM DM)沒有這一列、或三個都是 false,
/// 就跟以前一樣什麼都看得到;打開之後,那個職能的 DM 只看得到跟自己職能相關的內容。
/// 管理者、看板建立者、Team Leader、PMD 不受影響。
model DmScope {
  discipline  GroupDiscipline @id
  /// 工作項:只看得到指派給自己與同職能組員的項目(加上它們的上層項目)。
  limitItems  Boolean         @default(false)
  /// 人力表與人力規劃彙總:只看得到同職能單位的名額與欄位。
  limitLabour Boolean         @default(false)
  /// 預算金額:階段預算、NRE 報價單、樣機 BOM 的金額看不到。
  limitBudget Boolean         @default(false)
}
/// 一個階段要用掉某個單位幾個人月。階段 × 單位交叉起來就是人力規劃表,
/// 它加總起來就是這個階段的人力預算 —— 所以人力那一列不是手填的金額,
/// 而是這張表算出來的。
///
/// 掛在階段那一列工作項上,跟 Budget 一樣的錨點。
model LabourPlan {
  id           String      @id @default(cuid())
  /// 掛在預算階段上,不是看板工作項:一個階段就是一段要編人力的計畫,
  /// 而兩個階段可以對到看板上同一列(DVT1、DVT2 → DVT),掛在工作項上
  /// 的話那兩段會擠成一筆。
  phaseId      String
  phase        BudgetPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  discipline   String
  orgUnit      OrgUnit     @relation(fields: [discipline], references: [code], onDelete: Restrict, onUpdate: Cascade)
  /// 人月,允許到小數點兩位(0.5 個人月是常見的寫法)。
  personMonths Decimal     @db.Decimal(8, 2)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phaseId, discipline])
}

model SystemSettings {
  id                        String             @id @default("global")
  emailNotificationsEnabled Boolean            @default(false)
  /// 這套系統要啟用哪些通知類型——關掉的話,不管使用者個人設定怎麼選,
  /// 那個類型的通知(站內與 email)都不會產生。
  enabledNotificationTypes  NotificationType[] @default([ASSIGNED, UPDATED, COMMENTED, AUTOMATION, CREATED, DELETED, DEADLINE, CHAT, APPROVAL])
  levelColors               String[]           @default([])
  ganttDurationMode         GanttDurationMode  @default(BUSINESS)
  ganttOverdueColor         String             @default("#e2445c")
  ganttCompletedColor       String             @default("#9ca3af")
  ganttInProgressColor      String             @default("#00c875")
  ganttPausedColor          String             @default("#fdab3d")
  predReadyColor            String             @default("#00c875")
  predWaitingColor          String             @default("#fdab3d")
  predBlockedColor          String             @default("#e2445c")
  /// 一天算幾小時 — 把「配置 50%、做 10 天」換算成工時與成本的那個係數。
  hoursPerDay               Int                @default(8)
  /// 一個人月算幾個工作天 — 把月薪換算成時薪、把人月換算成工時的係數。
  workingDaysPerMonth       Int                @default(21)
  /// 只掛在負責人欄位、沒有人員分配的工作項,算那位負責人幾 % 的工作量。0 = 不算。
  ownerDefaultAllocationPct Int                @default(2)
  /// 新看板要帶哪些欄位:[{ name, type, options }],順序就是欄位順序。
  /// Null means nobody has set one, and a new board falls back to the built-in
  /// list — the same one this used to be, hardcoded.
  defaultColumns            Json?
  /// BOM 欄位的系統預設(沒有自己設定的看板都沿用)。null = 內建的欄位。格式見 src/lib/bomColumns.ts。
  bomDefaultColumns         Json?
  /// 專案週報分發的排程時間。enabled 是總開關;dow 是星期幾(0=週日,
  /// 沿用 JS Date.getDay() 的編號,1=週一)。
  weeklyReportEnabled       Boolean            @default(false)
  weeklyReportDow           Int                @default(1)
  weeklyReportHour          Int                @default(6)
  weeklyReportMinute        Int                @default(0)
  /// 週報涵蓋的日期範圍:從星期幾到星期幾(0=週日 … 6=週六,同上)。預設週三到週二。
  /// 連續 1~7 天,每 7 天一輪——手動產生與排程寄的週報都照這個範圍。
  weeklyReportRangeStartDow Int                @default(3)
  weeklyReportRangeEndDow   Int                @default(2)
  /// 這週跑過了沒——存 ISO 週字串("2026-W39"),不是時間戳記,拿「這週
  /// 有沒有跑過」判斷,不用擔心 tick 間隔或時區把「跨過某個時刻」算錯。
  weeklyReportLastRunWeek   String?
  /// 排程最近一次真的動手(搶到這一輪、開始寄)的時間與結果。排程在背景跑、server.js 把回應丟掉,
  /// 沒有這兩個欄位就沒人知道它有沒有跑、寄成功了沒;系統設定頁的排程卡片顯示它們。
  weeklyReportLastRunAt     DateTime?
  weeklyReportLastRunNote   String?
  /// 週報排程前幾小時,寄信提醒各單位同仁更新工作事項。0 = 不提醒。
  weeklyReportReminderHours    Int     @default(0)
  /// 提醒信寄過了沒——存「那一輪週報所在的 ISO 週」,判斷方式跟 weeklyReportLastRunWeek 一樣。
  weeklyReportReminderLastWeek String?
  /// 資料庫備份的排程時間——同一套設計:enabled 總開關,frequency 決定
  /// dow 要不要比對("DAILY" 不比對,"WEEKLY" 才比對)。
  backupEnabled             Boolean            @default(false)
  backupFrequency           String             @default("DAILY")
  backupDow                 Int                @default(1)
  backupHour                Int                @default(3)
  backupMinute              Int                @default(0)
  /// 超過幾天的備份自動清除——預設值跟 scripts/backup-db.sh 的
  /// RETENTION_DAYS 預設一致。
  backupRetentionDays       Int                @default(60)
  /// 上次成功備份的日期("YYYY-MM-DD")——跟 weeklyReportLastRunWeek 同一個
  /// 判斷邏輯,只是改成「今天跑過了沒」,DAILY/WEEKLY 共用同一個欄位。
  backupLastRunDate         String?
  /// 請假、工時的「主管這一條路」要幾階主管都同意才算核准(1 = 只要直屬主管,2 = 直屬 + 二階 …)。
  /// 各階同時送審,全部都同意才成立;沒有那麼多階主管就算到最高那一階。
  leaveApprovalLevels       Int                @default(1)
  /// 這些組織(組織架構圖的部門)的主管,對所有看板都看得到預算金額。空 = 沒有人靠這條路看。
  budgetViewOrgNodeIds      String[]           @default([])
  timesheetApprovalLevels   Int                @default(1)
  updatedAt                 DateTime           @updatedAt
}

// Company-wide (not per-board) list of dates that business-day duration
// calculations should skip in addition to weekends.
model Holiday {
  id   String @id @default(cuid())
  date String @unique // "YYYY-MM-DD"
  name String
}

model CellValue {
  id       String @id @default(cuid())
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  value    Json   @default("null")

  @@unique([itemId, columnId])
}

/// A named set of filters someone got tired of re-entering — "我的逾期任務",
/// "本週要交的". Private to its owner unless shared with the board.
model SavedView {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  /// Visible to everyone who can open the board; only the owner can change it.
  isShared  Boolean  @default(false)
  /// { filters: ActiveFilter[], groupFilterId: string, searchQuery: string }
  /// — see parseViewConfig, which is what actually decides what is usable.
  config    Json
  createdAt DateTime @default(now())

  @@index([boardId, ownerId])
}

/// The shape of a phase — POC → EVT → PVT — captured from a group that
/// already ran, so the next project does not have to be typed in again.
/// App-wide, not per board: the point is to reuse it on the next board.
model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String?
  createdBy   User?    @relation("ProjectTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// The captured tree — see buildTemplateContent / parseTemplateContent.
  /// Columns are held by name and dependencies by position, so a template
  /// is not tied to the board it came from.
  content     Json
  createdAt   DateTime @default(now())
}

enum RiskKind {
  /// Something that has not happened yet, and might not.
  RISK
  /// Something that already has.
  ISSUE
}

enum RiskStatus {
  OPEN
  MITIGATING
  /// 負責人申請結案,等所有審核人同意。全部同意才會變成 CLOSED。
  PENDING_REVIEW
  CLOSED
}

/// The Risk/Issue register: what could go wrong, how bad it would be, who is
/// dealing with it. Deliberately separate from Item — a risk is not a task on
/// the schedule, and putting it there would put it on the critical path.
model RiskEntry {
  id             String     @id @default(cuid())
  boardId        String
  board          Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  kind           RiskKind   @default(RISK)
  status         RiskStatus @default(OPEN)
  title          String
  description    String?
  /// 1-5 each; the register sorts on their product — see riskScore.
  probability    Int        @default(3)
  impact         Int        @default(3)
  /// 發生的話要多少錢(元)。沒填就算不出 EMV,那一筆只會有 1-5 的分數。
  costImpact     Int?
  /// 機率的百分比。填了就用它算 EMV,沒填就用 probability 這一級推算——
  /// 「中等機率」要換成一個數字才乘得下去,而那個換算值本來就該講明白。
  probabilityPct Int?
  /// The countermeasure, and who owes it.
  mitigation     String?
  ownerId        String?
  owner          User?      @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// "YYYY-MM-DD" — when the countermeasure is due, not when the risk hits.
  dueDate        String?
  /// The work item this is about, when there is one. Kept as a plain id
  /// rather than a relation: trashing the item must not take the risk with
  /// it — the risk is often the reason the item is being reworked.
  itemId         String?

  /// 從 MantisBT 同步來的議題:Mantis 的議題編號與當時抓到的資訊。有值的這一筆內容以 Mantis 為準,
  /// 在這裡是唯讀的(下一次同步會蓋回來),要改請到 Mantis。
  mantisId        Int?
  mantisUrl       String?
  /// Mantis 上的狀態名稱(原文,例如 assigned、resolved)。
  mantisStatus    String?
  mantisHandler   String?
  mantisUpdatedAt DateTime?
  /// Issue 分頁顯示用的 Mantis 欄位原文(嚴重度、優先權、分類、回報人)。
  mantisSeverity  String?
  mantisPriority  String?
  /// Mantis 列舉值的編號(狀態、嚴重度、優先權、處理人):同步時填,比對與寫回用;顯示用的文字在上面。
  mantisStatusId   Int?
  mantisSeverityId Int?
  mantisPriorityId Int?
  mantisHandlerId  Int?
  mantisCategory  String?
  mantisReporter  String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activityTimeEntries ActivityTimeEntry[]
  /// 審核人:申請結案之後,每一位都同意才算解除。
  reviewers           RiskReviewer[]
  /// 指派給負責人、審核人時的通知。
  notifications       Notification[]
  /// 負責人的進度更新(時間軸,寫了不能改)。
  updates             RiskUpdate[]
  /// 待辦事項(跟工作項的待辦事項同一個樣子)。
  todos               RiskTodo[]
  /// 建立、改欄位、申請結案、同意、退回的紀錄。
  logs                ActivityLogEntry[]

  @@unique([boardId, mantisId])
  @@index([boardId, status])
}

/// 看板與 MantisBT 專案的連線(一個看板對一個 Mantis 專案,單向:Mantis → 本系統)。
/// 同步下來的 Mantis 議題成為這個看板「風險與議題」裡的議題,並掛在 issueItemId 這個「ISSUE」工作項底下。
model MantisConnection {
  id          String   @id @default(cuid())
  boardId     String   @unique
  board       Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Mantis 網站的根網址,例如 https://mantis.example.com(不含 /api/rest)。
  baseUrl     String
  projectId   Int
  projectName String
  /// API token,AES-256-GCM 加密後存放(見 secretBox.ts),不會回傳給畫面。
  tokenEnc    String
  enabled     Boolean  @default(true)
  /// 同步下來的議題都掛在這個「ISSUE」工作項;建立連線時建立。
  issueItemId String?
  lastSyncAt  DateTime?
  /// 上一次同步的錯誤訊息;成功就是 null。
  lastSyncError String?
  /// 上一次同步的結果:{ total, created, updated, unchanged, truncated }。
  lastSyncSummary Json?
  /// 欄位對應與寫回設定(見 mantisMapping.ts);null = 預設值(跟以前寫死的規則一樣,而且不寫回)。
  mapping     Json?
  /// 同步時從問題的處理人 / 回報人收集到的 Mantis 使用者:[{ id, name, realName, email }],寫回處理人時比對用。
  users       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// 風險/議題的審核人。approvedAt 為 null = 這一輪還沒同意;申請結案、退回、重新開啟時都會清掉。
model RiskReviewer {
  id         String    @id @default(cuid())
  riskId     String
  risk       RiskEntry @relation(fields: [riskId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation("RiskReviewer", fields: [userId], references: [id], onDelete: Cascade)
  approvedAt DateTime?

  @@unique([riskId, userId])
  @@index([userId])
}

/// 負責人(與有編輯權的人)對一筆風險/議題寫的進度更新。
model RiskUpdate {
  id        String    @id @default(cuid())
  riskId    String
  risk      RiskEntry @relation(fields: [riskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?     @relation("RiskUpdateAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  createdAt DateTime  @default(now())

  @@index([riskId, createdAt])
}

/// 風險 / 問題 / 議題(含 Mantis 同步來的)的待辦事項——跟工作項的待辦事項(TodoItem)同一個樣子:
/// 勾完成、可以設期限,到期前一天、當天、逾期後各提醒一次。對話裡的訊息可以直接轉成這裡的待辦事項。
model RiskTodo {
  id        String    @id @default(cuid())
  riskId    String
  risk      RiskEntry @relation(fields: [riskId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean   @default(false)
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  /// 期限("YYYY-MM-DD",台北的日曆日)。null = 沒設期限。有設而且還沒完成的才提醒。
  dueDate   String?
  /// 提醒到哪一階段了:0 = 還沒提醒、1 = 明天到期、2 = 今天到期、3 = 已逾期。改期限時歸零。
  remindedStage Int @default(0)
  /// 誰新增的(提醒的收件人除了風險的負責人,也包含寫這一筆的人)。
  createdById String?
  /// 處理者:預設是風險 / 議題的負責人;對話轉過來、訊息裡有 @ 誰,就是那個人。有設的話,期限提醒給他。
  assigneeId String?
  /// 備註:讓使用者記錄這個待辦事項的處理狀態、結果。null = 沒有備註。
  note      String?

  @@index([riskId])
  @@index([dueDate])
  @@index([assigneeId])
}

/// A key for the read-only REST API. Only the hash is stored — a key that
/// can be read back out of the database is a key that leaks with a backup.
/// It carries its creator's board access rather than a permission model of
/// its own: the API can never show more than the person who issued the key.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  hashedKey  String    @unique
  /// The visible head of the key ("hrapp_1a2b3c…"), so a key can be told
  /// apart in the list without storing the rest of it.
  prefix     String
  ownerId    String
  owner      User      @relation("ApiKeyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

/// An outgoing HTTP callback for board events. Each delivery is signed with
/// the webhook's own secret so the receiver can tell a real one from anybody
/// who learned the URL.
model Webhook {
  id            String    @id @default(cuid())
  boardId       String
  board         Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  url           String
  secret        String
  /// "item.created" | "item.updated" | "item.deleted"
  events        String[]  @default([])
  active        Boolean   @default(true)
  /// Enough of a delivery log to debug a silent integration, without a
  /// second table filling up with every event ever sent.
  lastStatus    Int?
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([boardId])
}

/// One person's hours on one item on one day — the actual, against which
/// the planned allocationPct is only ever an estimate.
/// 公司組織架構圖上的一個部門(處、部、課…)。上下層用 parentId,主管用 headId;人用 User.orgNodeId 掛在部門底下。
/// 跟 OrgUnit(人力表的單位:EE、ME、SW…)是兩件事:那是算人力的欄位,這是講誰管誰。
model OrgNode {
  id        String    @id @default(cuid())
  name      String
  parentId  String?
  parent    OrgNode?  @relation("OrgTree", fields: [parentId], references: [id], onDelete: SetNull)
  children  OrgNode[] @relation("OrgTree")
  headId    String?
  head      User?     @relation("OrgNodeHead", fields: [headId], references: [id], onDelete: SetNull)
  /// 同一層部門的排列順序。
  order     Int       @default(0)
  members   User[]    @relation("OrgNodeMembers")
  roles     OrgRole[]
  /// 這個部門(含底下沒有自己對應的子部門)對應哪些人力單位(EE、ME…),可以好幾個。
  units     OrgNodeUnit[]
  createdAt DateTime  @default(now())

  @@index([parentId])
}

/// 組織架構圖的部門 ↔ 人力單位(EE、ME…)的對應,多對多:一個部門可以同時對應好幾個單位(例如品質管理部 = QA + FAE)。
/// 掛在這個部門(與底下沒有自己對應的子部門)的人,所屬單位(User.discipline)從這幾個裡面帶入:
/// 只有一個就直接帶入,有好幾個就由人選(User 的所屬單位已經在其中就維持)。
model OrgNodeUnit {
  nodeId   String
  node     OrgNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  unitCode String
  unit     OrgUnit @relation(fields: [unitCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@id([nodeId, unitCode])
  @@index([unitCode])
}

/// 部門裡主管以外的職能:副主管、行政、秘書……(職稱自己填)。
/// canApprove = true 的人,可以在這個部門的主管那一階代他簽核(主管出差時副主管可以簽);
/// 沒勾的只是標示在架構圖上。一個人在一個部門只有一個職稱。
model OrgRole {
  id         String   @id @default(cuid())
  nodeId     String
  node       OrgNode  @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation("OrgRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  title      String
  canApprove Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([nodeId, userId])
  @@index([userId])
}

enum ApprovalKind {
  TIME
  ACTIVITY
  LEAVE
}

/// 多階簽核:一筆待核准的紀錄(工時、對應專案的工時、請假),每一階主管各簽下的一筆。
/// 各階同時送審,所有需要的階都簽了才算核准;任一階退回就是退回(退回直接寫在那筆紀錄的狀態上)。
model ApprovalStep {
  id         String       @id @default(cuid())
  kind       ApprovalKind
  targetId   String
  /// 1 = 直屬主管,2 = 二階主管 …
  level      Int
  approverId String
  approver   User         @relation("ApprovalStepApprover", fields: [approverId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([kind, targetId, level])
  @@index([kind, targetId])
}

/// 送審狀態。核准前不算數:未核准的工時不會進 EVM 的實際成本,未核准的
/// 請假也不會改變產能判定——否則「已登記」就等於「已成立」,審核只是裝飾。
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimeEntry {
  id           String         @id @default(cuid())
  itemId       String
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD" — the day worked, not the day it was typed in.
  date         String
  hours        Decimal        @db.Decimal(6, 2)
  /// 從工作項預估匯入時,當初的預估時數(hours 是實際時數,可以再改)。null = 不是從預估匯入的。
  estimateHours Decimal?      @db.Decimal(6, 2)
  note         String?
  /// 一天中的開始時間(從 00:00 起算的分鐘數),行事曆畫面用來排位置。null = 沒排時間。
  startMinute  Int?
  /// 用「重複」一次建立的一批工時共用的識別;可以一次刪掉某一筆之後的整批。
  seriesId     String?
  status       ApprovalStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?          @relation("TimeEntryDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime       @default(now())

  @@index([itemId])
  @@index([userId, date])
  @@index([status])
  @@index([seriesId])
}

/// 非專案工時的類別(例行會議、突發問題處理……),管理員在系統設定自訂。
/// 停用而不刪除:舊的工時紀錄還引用著它。
model TimeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  active    Boolean  @default(true)
  /// 登記這個類別時,要不要提供「連結風險登記冊議題」的選項。
  linkIssue Boolean  @default(false)
  /// 登記這個類別時,可不可以選「對應專案」。部門週會、公司專案週會、請假這類不屬於任何專案的
  /// 類別關掉;例行會議、出差交通這類常常是為了某個專案而花的時間,開著。
  allowProject Boolean @default(true)
  createdAt DateTime @default(now())

  entries   ActivityTimeEntry[]
  templates TimeTemplate[]
}

/// 不屬於任何看板工作項的工時(會議、突發問題處理、教育訓練……)。
///
/// 刻意跟 TimeEntry 分成兩張表,不是把 itemId 改成選填:專案成本/EVM 的
/// 實際成本(costInputs.ts 等)靠 item 關聯過濾 TimeEntry,非專案工時一旦
/// 混進同一張表,哪天過濾條件一改就會悄悄漏進專案成本。這張表登記即生效,
/// 不走審核。
model ActivityTimeEntry {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD" — the day worked, 跟 TimeEntry.date 同一個格式。
  date        String
  hours       Decimal      @db.Decimal(6, 2)
  categoryId  String
  category    TimeCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  note        String?
  /// 一天中的開始時間(從 00:00 起算的分鐘數),行事曆畫面用來排位置。null = 沒排時間。
  startMinute Int?
  /// 從外部日曆匯入的識別(「gcal:」+ Google 行程 id)。同一個人同一個行程只會有一筆,重複匯入就是更新。
  externalId  String?
  /// 用「重複」一次建立的一批工時共用的識別;可以一次刪掉某一筆之後的整批。
  seriesId    String?
  /// 連到的風險登記冊議題;議題刪掉只是斷開連結,不連帶刪工時。
  riskEntryId String?
  riskEntry   RiskEntry?   @relation(fields: [riskEntryId], references: [id], onDelete: SetNull)
  /// 對應的專案(看板)。有對應專案的工時要主管核准才算進那個專案的成本;沒有對應專案就登記即生效。
  boardId      String?
  board        Board?         @relation(fields: [boardId], references: [id], onDelete: SetNull)
  status       ApprovalStatus @default(APPROVED)
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt   DateTime     @default(now())

  @@unique([userId, externalId])
  @@index([seriesId])
  @@index([userId, date])
  @@index([date])
  @@index([boardId, status])
}

/// 工時範本:例行會議等每週重複登記的工時,套用到某一週就一次建立(同一天同一筆不會重複)。
///
/// ownerId = null 是管理者建立、大家都能用的共用範本——只能是「會議與其他」(categoryId),
/// 不能指定工作項(工作項是各人被指派的)。個人範本可以是會議與其他,也可以是專案工作項(itemId)。
model TimeTemplate {
  id          String        @id @default(cuid())
  name        String
  ownerId     String?
  owner       User?         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    TimeCategory? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  itemId      String?
  item        Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 會議與其他的「對應專案」。專案被刪掉只是少了這個對應,範本還在。
  boardId     String?
  board       Board?        @relation(fields: [boardId], references: [id], onDelete: SetNull)
  /// 一天中的開始時間(從 00:00 起算的分鐘數);null = 不排時間。
  startMinute Int?
  hours       Decimal       @db.Decimal(6, 2)
  note        String?
  /// 套用到一週時排在哪幾天:1 = 週一 … 7 = 週日。
  weekdays    Int[]
  createdAt   DateTime      @default(now())

  @@index([ownerId])
}

/// A saved plan, kept whole.
///
/// The board's Item.baselineStart/End/Days stay as the *active* baseline —
/// every existing reader (甘特圖長條、項目卡片、S 曲線、EVM 的 PV) keeps
/// working unchanged — and this table is the archive those values are
/// copied from and to. Re-capturing no longer destroys the previous plan:
/// "跟三月那版比" is the question a baseline exists to answer, and until now
/// the answer was gone the moment somebody re-planned.
model Baseline {
  id             String          @id @default(cuid())
  boardId        String
  board          Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 使用者取的名字, e.g. "EVT 啟動版"; defaults to the capture date.
  name           String
  capturedAt     DateTime        @default(now())
  capturedById   String?
  /// How many items had resolvable dates when it was taken.
  itemCount      Int             @default(0)
  entries        BaselineEntry[]
  /// 哪些變更單是靠這一版基準線落地的 — 「為什麼日期變了」的答案。
  changeRequests ChangeRequest[]

  @@index([boardId, capturedAt])
}

/// One item's dates within one saved baseline.
model BaselineEntry {
  id         String   @id @default(cuid())
  baselineId String
  baseline   Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  /// Plain id, not a relation: a baseline outlives the items in it, and an
  /// item that has since been deleted should not delete the plan's record
  /// that it was once scheduled.
  itemId     String
  start      String?
  end        String?
  days       Int?

  @@unique([baselineId, itemId])
}

/// One person allowed to see one private 工作項.
model ItemViewer {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

/// One person allowed to see one private 分組.
model GroupViewer {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

/// 個人休假. Holiday is company-wide; this is one person being away.
///
/// It does NOT move the schedule: the scheduling engine deliberately knows
/// nothing about who is doing the work, and making dates depend on one
/// person's leave would mean the same task showing different dates as soon
/// as it is reassigned. What it does is tell the workload views that this
/// person has no capacity those days.
model Leave {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD", both inclusive.
  startDate    String
  endDate      String
  reason       String?
  status       ApprovalStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?          @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime       @default(now())

  @@index([userId, startDate])
  @@index([status])
}

/// 一組一起交付的看板 —— POC 看板、EVT 看板、PVT 看板同屬一個「AMR 平台」。
///
/// 它存在的理由只有一個:讓「專案」有一個比看板大的邊界,好讓跨看板的前置、
/// 一條共同的要徑、一個共同的完工日有對象可言。
/// 階段閘門的狀態。NPI 是閘門式的:DVT 沒過不能進 PVT,而"過"是一個
/// 有人負責、有時間、有理由的決定,不是一個勾選框。
enum GateStatus {
  /// 還在準備,條件還沒補齊。
  DRAFT
  /// 已送審,等簽核人表態。
  PENDING
  /// 通過放行。
  PASSED
  /// 不通過,要補件重送。
  FAILED
  /// 有條件放行:必要條件沒有全過,但決定往下走。理由必填——
  /// 這是整個機制裡唯一值得事後翻出來看的一筆。
  WAIVED
}

enum GateDecision {
  APPROVED
  REJECTED
}

/// 一個階段的出口閘門。掛在階段那一列工作項上(例如「EVT Phase」),
/// 因為放行與否講的是那個階段,不是某一張表。
model Gate {
  id           String     @id @default(cuid())
  boardId      String
  board        Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 這個閘門收尾的階段。可為 null:有些閘門(例如 MRD 凍結)不屬於任何
  /// 一個階段列。刪掉那一列不該連帶刪掉簽核紀錄,所以存純 id。
  itemId       String?
  name         String
  status       GateStatus @default(DRAFT)
  /// "YYYY-MM-DD" 預計審查日。
  plannedDate  String?
  /// 誰、什麼時候、為什麼下了最後那個決定。
  decidedAt    DateTime?
  decidedById  String?
  decidedBy    User?      @relation("GateDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote String?

  criteria  GateCriterion[]
  approvers GateApprover[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boardId, status])
}

/// 一條進出條件。required 的沒有全部達成就不能 PASSED,只能 WAIVED。
model GateCriterion {
  id       String  @id @default(cuid())
  gateId   String
  gate     Gate    @relation(fields: [gateId], references: [id], onDelete: Cascade)
  text     String
  required Boolean @default(true)
  met      Boolean @default(false)
  /// 佐證的工作項,有的話。同樣存純 id。
  itemId   String?
  order    Int     @default(0)

  @@index([gateId])
}

/// 一位簽核人。每個人各自表態,缺一個就還沒過。
model GateApprover {
  id        String        @id @default(cuid())
  gateId    String
  gate      Gate          @relation(fields: [gateId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// null = 還沒表態。
  decision  GateDecision?
  decidedAt DateTime?
  comment   String?

  @@unique([gateId, userId])
  @@index([gateId])
}

/// 變更單的生命週期。
enum ChangeStatus {
  DRAFT
  /// 已送出,等核准。
  SUBMITTED
  /// 核准了,但還沒動到計畫。
  APPROVED
  REJECTED
  /// 已執行 — 通常伴隨重新建立基準線。
  IMPLEMENTED
  /// 提出的人自己收回。
  WITHDRAWN
}

/// 一張工程變更單(ECR)。
///
/// 基準線已經留得住「日期變成什麼樣」,留不住「為什麼變、誰批准、預期影響
/// 多少」。三個月後爭的都是後面那三件事,所以這裡才是要寫下來的地方。
model ChangeRequest {
  id          String       @id @default(cuid())
  boardId     String
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 看板內的流水號,顯示成 CR-001。
  number      Int
  title       String
  /// 改什麼。
  description String?
  /// 為什麼要改。整張單子三個月後只有這一欄有人會回來看。
  reason      String?
  status      ChangeStatus @default(DRAFT)

  /// 影響評估:提出時的預估,不是事後的實際值。
  scheduleImpactDays Int?
  /// 元,與 Item.budgetCost 同單位。
  costImpact         Int?
  impactNote         String?

  /// 受影響的工作項。存純 id:工作項被丟進垃圾桶不該把變更紀錄一起帶走。
  itemIds String[] @default([])

  requestedById String?
  requestedBy   User?     @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?     @relation("ChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?

  /// 執行這次變更時建立的那一版基準線。把「為什麼」接到「結果」。
  baselineId String?
  baseline   Baseline? @relation(fields: [baselineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, number])
  @@index([boardId, status])
}

/// 費用類別。預算按類別核准,花費也按類別記,才看得出是哪一類爆掉。
enum CostCategory {
  /// 人力。不必手動記帳——由核准過的工時 × 時薪自動算出。
  LABOUR
  MATERIAL
  TOOLING
  OUTSOURCING
  TRAVEL
  OTHER
  /// 驗證與認證:環境、壽命測試與法規認證(CE、FCC、BSMI)的實驗室費用與規費。
  CERTIFICATION
}

/// NRE 報價單的四大項(跟預算的各類別是兩套:報價單是估算與報價的依據,不會寫進核准預算)。
enum NreCategory {
  /// 研發人力工時 —— 外部單位 / 人員投入的工時。
  LABOUR
  /// 模具與治具:外殼鋼模、組裝治具、測試夾具。
  TOOLING
  /// 打樣與測試樣品:PCB 打樣、3D 列印、CNC、小批量試產。
  PROTOTYPE
  /// 驗證與認證:環境 / 壽命測試、法規認證。
  CERTIFICATION
  /// 委託開發:委託外部單位開發的項目(委託單位、委託項目、時間範圍,哪一個階段或涵蓋整個專案)。
  COMMISSIONED
}

/// NRE(一次性工程費用)報價單的一列。
///
/// 一般掛在一個預算階段上;委託開發那一類可以不掛階段(phaseId 是 null),代表涵蓋整個專案。
/// 所以每一列都帶 boardId——整個專案的合計要靠它找得到那些沒有階段的列。
///
/// 有數量跟單價時,金額就是兩者相乘(存的時候算好,所有加總讀 amount 一欄);
/// 沒有的話金額直接填。研發人力那一類的 vendor 是外部單位或人員,數量是工時、單價是時薪;
/// 委託開發那一類的 vendor 是委託單位、description 是委託項目,並且有時間範圍。
model NreLine {
  id          String       @id @default(cuid())
  boardId     String
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// null = 涵蓋整個專案(只有委託開發可以)。
  phaseId     String?
  phase       BudgetPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  category    NreCategory
  /// 同一類別裡的排列順序。
  order       Int         @default(0)
  /// 細項說明。
  description String
  /// 估算基礎 / 數量的文字說明,例如「3 位工程師 × 3 個月」。
  basis       String?
  /// 外部單位或人員(研發人力用),也可以是模具廠、實驗室。
  vendor      String?
  quantity    Float?
  /// 元。
  unitPrice   Int?
  /// 元,存的是算好的金額。
  amount      Int
  /// 時間範圍,"YYYY-MM-DD"(委託開發用;起訖要一起填或一起空白)。
  startDate   String?
  endDate     String?
  note        String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([phaseId, category, order])
  @@index([boardId, category, order])
}

/// 一筆核准預算:由上而下的那個數字。
///
/// 跟 Item.budgetCost 不同,那是由下而上、每個工作項各自估的,拿來算 CPI
/// 「做掉的事有沒有比估的貴」。這裡的是「這個階段/這個專案總共核准多少錢」,
/// 拿來回答「還剩多少可以花」——兩個問題不一樣,所以兩份數字並存。
model Budget {
  id        String       @id @default(cuid())
  /// 恰好其中一個有值:預算階段、看板上的一列工作項,或整個專案群組。
  ///
  /// phaseId 是現在的主軸:預算是「計畫」,而計畫的單位是預算階段 ——
  /// DVT1 與 DVT2 是兩段各自要編預算的計畫,即使它們對到看板上同一列。
  /// 實際花費(Expense/Commitment)仍然掛在看板工作項上,因為錢是花在真正
  /// 做的事情上;兩邊分開才比得出「估的」與「花的」差多少。
  ///
  /// itemId 留著給沒有建預算階段的看板沿用,語意不變。
  phaseId   String?
  phase     BudgetPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  programId String?
  program   Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)

  category CostCategory
  /// 元。
  amount   Int
  note     String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phaseId, category])
  @@unique([itemId, category])
  @@unique([programId, category])
}

/// 已下單未入帳。
///
/// PO 一簽,錢實質上已經花掉了,但發票還沒進來——實際成本看不到它。少了這一
/// 欄,「還剩多少可用」會一路高估到發票到齊那天,而那天通常已經來不及。
model Commitment {
  id     String @id @default(cuid())
  /// 這筆訂單掛在哪一列工作項上(可以是階段那一列,也可以是底下某個任務)。
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  category       CostCategory
  /// 換算後的台幣金額,凍結在下單當下。所有加總都用這一欄。
  amount         Int
  /// 幣別。TWD 時 originalAmount 就等於 amount、fxRate 是 1。
  currency       String       @default("TWD")
  /// 外幣原始金額 — 報價單上寫的那個數字。
  originalAmount Int          @default(0)
  /// 記帳當下的匯率,凍結。之後匯率再怎麼動,這一筆的台幣金額不變。
  fxRate         Decimal      @default(1) @db.Decimal(12, 4)
  vendor         String?
  poNumber       String?
  /// "YYYY-MM-DD" 預計到貨或入帳日。
  expectedDate   String?
  /// 入帳之後就不再算進「已承諾」——那筆錢已經變成實際支出了。
  settled        Boolean      @default(false)
  settledAt      DateTime?
  note           String?

  attachments Attachment[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([itemId, settled])
}

/// 一筆實際支出。
///
/// 記在分組(階段)上,需要的話再連到某個工作項。往上一路 group → board →
/// program,所以階段預算和群組預算讀的是同一本帳,不必記兩次。
///
/// 人力不走這裡:它由核准過的工時算出來,手動再記一次就會重複計算。
model Expense {
  id     String @id @default(cuid())
  /// 這筆錢花在哪一列工作項上。階段層的支出(例如整個 EVT 的差旅)就掛在
  /// 階段那一列。
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  category       CostCategory
  /// 換算後的台幣金額,凍結在記帳當下。所有加總都用這一欄。
  amount         Int
  /// 幣別。TWD 時 originalAmount 就等於 amount、fxRate 是 1。
  currency       String       @default("TWD")
  /// 外幣原始金額 — 報價單上寫的那個數字。
  originalAmount Int          @default(0)
  /// 記帳當下的匯率,凍結。之後匯率再怎麼動,這一筆的台幣金額不變。
  fxRate         Decimal      @default(1) @db.Decimal(12, 4)
  /// "YYYY-MM-DD" 發生日,不是輸入日。
  date           String
  vendor         String?
  note           String?
  /// 這筆支出結清的是哪一張 PO,有的話。
  commitmentId   String?

  attachments Attachment[]

  createdById String?
  createdAt   DateTime @default(now())

  @@index([itemId, date])
}

/// 匯率表。
///
/// 只用來預填輸入框——實際換算用的永遠是每一筆自己存下來的 fxRate。匯率天天
/// 在動,如果總額跟著今天的匯率浮動,上個月結的帳下個月就會變成另一個數字。
/// 這張表同時也是「系統有哪些幣別」的清單;台幣是基準幣別,不在裡面。
model ExchangeRate {
  /// ISO 代碼,例如 "USD"。
  code        String   @id
  /// 1 單位外幣等於多少台幣。
  rate        Decimal  @db.Decimal(12, 4)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// 準備金的兩種。分開是因為動用它們的授權層級不一樣。
enum ReserveKind {
  /// 應變準備金:留給「已知會有風險、只是不知道會不會發生」的那些事。
  /// 專案負責人可以動支。
  CONTINGENCY
  /// 管理準備金:留給想都沒想到的事。通常要更高層才動得了。
  MANAGEMENT
}

/// 一筆準備金。跟核准預算掛在同一層:階段各自一筆,專案群組也可以有自己的。
///
/// 它不是一個可以直接花的類別 —— 錢要先「動支」撥進某個類別才花得出去
/// (見 ReserveDraw)。少了這一層,「還剩 20 萬」就分不出那是可以花的錢,
/// 還是本來就該留著的緩衝。
model Reserve {
  id        String       @id @default(cuid())
  phaseId   String?
  phase     BudgetPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  programId String?
  program   Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)

  kind   ReserveKind
  /// 元。核准的原始額度,動支不會改這個數字——餘額是它減掉動支。
  amount Int
  note   String?

  draws ReserveDraw[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phaseId, kind])
  @@unique([itemId, kind])
  @@unique([programId, kind])
}

/// 一次動支:把準備金撥進某個費用類別。
///
/// 撥款會同步把該類別的核准預算加上同一個金額,所以總額不變——動支是搬錢,
/// 不是生錢。理由必填:準備金被花掉的原因,是事後唯一有人會回來看的東西。
model ReserveDraw {
  id        String  @id @default(cuid())
  reserveId String
  reserve   Reserve @relation(fields: [reserveId], references: [id], onDelete: Cascade)

  /// 撥給哪一個費用類別。
  category CostCategory
  amount   Int
  reason   String

  decidedById String?
  decidedBy   User?    @relation("ReserveDrawDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([reserveId])
}

model Program {
  id                 String                     @id @default(cuid())
  name               String
  /// 誰建立的。預算編輯權要認「專案建立者」,群組層得有個對象可以認。
  /// 這個欄位之前建立的群組是 null,那些就只有管理者能編。
  createdById        String?
  createdAt          DateTime                   @default(now())
  boards             Board[]
  budgets            Budget[]
  reserves           Reserve[]
  reportSubscription ProgramReportSubscription?
  reportSnapshots    ProgramReportSnapshot[]
}

/// 一個專案群組的週報分發訂閱:多久寄一次(排程設定在 SystemSettings,
/// 是全域的,這裡只有內容範圍)、寄給誰、寄哪些區塊。
///
/// 跟 WeeklyReport 是兩回事:WeeklyReport 是「一人一份、可以在週報頁面
/// 回看」的個人視角報告;這裡分發出去的報告不看任何人的權限(收件人可能
/// 是外部信箱,本來就沒有帳號),只寄信、不建可回看的紀錄。
model ProgramReportSubscription {
  id                 String                   @id @default(cuid())
  programId          String                   @unique
  program            Program                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// 「接下來幾天」的視窗長度——每個專案群組自己設,不是全域一個值。
  upcomingDays       Int                      @default(7)
  includeSummary     Boolean                  @default(true)
  includeProgramDiff Boolean                  @default(true)
  /// 專案時程與預算那一段裡,要不要列預算金額。收件人可能是外部信箱,沒有帳號可以問權限,所以由管理者在這裡決定。
  includeBudget      Boolean                  @default(true)
  includeDepartments Boolean                  @default(true)
  includeActivity    Boolean                  @default(true)
  recipients         ProgramReportRecipient[]
  updatedAt          DateTime                 @updatedAt
}

/// 一個收件人。現有帳號填 userId(信箱跟著帳號走,改帳號信箱不用回來改
/// 這裡);系統外的人填 email。兩者互斥,不會同時有值。
model ProgramReportRecipient {
  id             String                    @id @default(cuid())
  subscriptionId String
  subscription   ProgramReportSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 自由填的外部信箱,userId 是 null 時才有值。
  email          String?

  @@unique([subscriptionId, userId])
}

/// 分發出去的專案週報,拿來跟下一週比對用的快照——跟 WeeklyReport 是同一個
///概念,但這份不是給人在「週報」頁面回看的,只是給「這一週 vs 上一週」的
/// diffWeeks 找上一份用,所以不掛使用者、不存 markdown、欄位比 WeeklyReport
/// 精簡。
model ProgramReportSnapshot {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekStart String
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([programId, weekStart])
}

/// 一份存下來的週報。
///
/// 存起來不只是為了有歷史可以翻:「這週完成了什麼」是拿這一份跟上一週那
/// 一份比出來的,沒有存檔就只能去解析活動紀錄那幾句中文再猜一次。
///
/// 一個人一週一份 —— 看得到哪些看板是跟著人走的,所以週報也是。
model WeeklyReport {
  id        String @id @default(cuid())
  /// ISO 週的週一,"YYYY-MM-DD"。
  weekStart String
  weekEnd   String
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 完整結構化內容,頁面跟下一週的比對都讀它。
  data      Json
  /// 產出當下排版好的 Markdown —— 之後改了排版,舊的那幾份仍然是當初寄出去的樣子。
  markdown  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

/// 一個透過動態註冊(RFC 7591)登記的 OAuth 用戶端。
///
/// MCP 的遠端連接器要求可以自己註冊 —— 沒有這一支,每接一個用戶端都得有
/// 人先到後台手動建一筆。註冊本身不代表任何權限:能拿到什麼,要等某個人
/// 在同意畫面上按下允許。
model OAuthClient {
  id           String   @id @default(cuid())
  /// 給用戶端的 client_id,對外可見。
  clientId     String   @unique
  /// 顯示在同意畫面上的名字,由用戶端自己申報,只是給人看的。
  name         String
  /// 授權碼只能送到這幾個網址,而且要完全相同。
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  tokens OAuthToken[]
}

/// 一次性的授權碼。
///
/// 存的是雜湊,而且活得很短 —— 它只需要活到用戶端把它換成權杖為止。
/// usedAt 有值就不能再換:攔到授權碼的人重放一次會被擋下來。
model OAuthCode {
  id            String      @id @default(cuid())
  hashedCode    String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 換權杖時要帶同一個,不同就拒絕。
  redirectUri   String
  codeChallenge String
  /// RFC 8707:這張授權碼是為了哪個資源發的。
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
}

/// 一張存取權杖(以及它的更新權杖)。
///
/// 跟 API 金鑰分開:這一張會過期、綁著某個用戶端、可以連人帶用戶端一起
/// 撤銷。兩者都存雜湊,所以外流的備份裡沒有能用的東西。
model OAuthToken {
  id                 String      @id @default(cuid())
  hashedAccessToken  String      @unique
  hashedRefreshToken String?     @unique
  clientId           String
  client             OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource           String?
  expiresAt          DateTime
  refreshExpiresAt   DateTime?
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  createdAt          DateTime    @default(now())

  @@index([userId])
  @@index([expiresAt])
}

enum ChatKind {
  /// 看板頻道:每個看板一間,看得到看板的人都能進來聊。
  BOARD
  /// 兩個人的私訊。
  DM
  /// 自己挑成員建的聊天室。
  GROUP
}

model ChatConversation {
  id            String   @id @default(cuid())
  kind          ChatKind
  /// BOARD 才有:每個看板最多一間頻道。
  boardId       String?  @unique
  board         Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// DM 才有:兩個人的 id 排序後用「:」接起來,同一對人只會有一間私訊。
  dmKey         String?  @unique
  /// GROUP 才有:聊天室名稱。
  title         String?
  createdById   String?
  createdAt     DateTime @default(now())
  /// 最後一則訊息的時間——對話清單依它排序。
  lastMessageAt DateTime @default(now())

  members       ChatMember[]
  messages      ChatMessage[]
  notifications Notification[]

  @@index([kind])
  @@index([lastMessageAt])
}

/// 誰在這間對話裡,以及讀到哪裡。BOARD 頻道的成員資格看看板權限、不看這張表;
/// 這裡的列只用來記每個人的已讀時間(第一次打開、或有人發言時才建)。
model ChatMember {
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 讀到哪一則(那一則的時間):未讀 = 比它晚、而且不是自己發的訊息。
  lastReadAt     DateTime         @default(now())
  joinedAt       DateTime         @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body           String
  createdAt      DateTime         @default(now())
  /// 收回:訊息還留著(別人的回覆、已讀時間都對得上),內容不再顯示。
  deletedAt      DateTime?
  attachments    ChatAttachment[]

  @@index([conversationId, createdAt])
  @@index([authorId])
}

/// 對話裡傳的檔案與圖片。檔案放在 public/uploads/chat/ 底下,但不直接對外服務,
/// 一律走 /api/chat/attachments/:id,先檢查看不看得到那間對話。
model ChatAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName  String
  /// 磁碟上的位置(相對於 public/)。連結(isLink)則是外面的網址或本系統看板的位置。
  url       String
  size      Int
  /// 連結:不是檔案,沒有東西在磁碟上;fileName 是顯示的名字,size 是 0。
  isLink    Boolean     @default(false)
  createdAt DateTime    @default(now())

  @@index([messageId])
}

/// 即時推送的收件匣:每個 worker 行程定時讀新的列、推給自己手上連線的人。
/// 用資料庫當匯流排,是因為 server.js 是多行程(cluster),一個行程收到的
/// 訊息要讓所有行程上的連線都看得到;斷線重連時瀏覽器帶 Last-Event-ID 回來,
/// 就能從這張表補發漏掉的。舊的列會被清掉,只留最近一天。
model ChatEvent {
  id             Int      @id @default(autoincrement())
  /// message(新訊息)/ read(已讀)/ deleted(收回)/ conversation(對話清單有變:被加進群組……)/
  /// comment(工作項有新留言,讓開著那個工作項的人即時看到)。
  type           String
  /// 事件發生的對象:對話 id;comment 事件是工作項 id。
  conversationId String
  /// message、deleted、comment:發訊息或留言的人;read:讀的人;conversation:要通知的那個人。
  userId         String?
  messageId      String?
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

enum FeedbackStatus {
  OPEN
  RESOLVED
}

/// 使用者在畫面上按「說明與問題回報」寫下的問題:哪個畫面、誰、寫了什麼。管理者在「使用者回報」頁統一看與處理。
model UserFeedback {
  id           String         @id @default(cuid())
  userId       String?
  user         User?          @relation("UserFeedbackAuthor", fields: [userId], references: [id], onDelete: SetNull)
  /// 送出當下的姓名與 Email:帳號之後被刪除,回報還留著看得出是誰寫的。
  userName     String
  userEmail    String
  /// 送出時的畫面網址(路徑與查詢字串,不含網域)。
  path         String
  /// 那個畫面的名稱(例如「甘特圖」)與對應的手冊章節錨點(例如 ch-9)。
  pageLabel    String
  manualAnchor String
  message      String
  /// 用「選取元素」送出時附上的位置資訊(選到的元素的標籤、文字、selector、上層鏈、HTML 片段,加上視窗大小與瀏覽器),
  /// 給管理者交給 Claude Code 除錯用。形狀見 src/lib/feedbackContext.ts;沒選元素的回報是 null。
  context      Json?
  status       FeedbackStatus @default(OPEN)
  /// 管理者處理時留的說明。
  adminNote    String?
  resolvedAt   DateTime?
  resolvedByName String?
  createdAt    DateTime       @default(now())

  @@index([status, createdAt])
  @@index([userId])
}
