generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  SUPERVISOR
  MEMBER
}

enum ColumnType {
  TEXT
  STATUS
  PERSON
  DATE
  NUMBER
}

enum BoardVisibility {
  PUBLIC
  RESTRICTED
}

/// 可見範圍 for a 分組 or a 工作項. PRIVATE keeps a row off other people's
/// screens without taking it out of the schedule — see itemVisibility.
enum RowVisibility {
  PUBLIC
  PRIVATE
}

/// A date the schedule must respect whatever the Pred chain computes.
/// START_NO_EARLIER_THAN and MUST_FINISH_ON move the item; FINISH_NO_LATER_THAN
/// is a deadline — it does not make work go faster, it reports being late.
enum ItemConstraintType {
  START_NO_EARLIER_THAN
  FINISH_NO_LATER_THAN
  MUST_FINISH_ON
}

enum GanttDurationMode {
  CALENDAR
  BUSINESS
}

// Per-Group leadership roles. TEAM_LEADER and PMD get schedule-edit rights
// across the whole group; SW_DM/HW_DM/ME_DM/QA get item-create/assign/
// progress-management rights scoped to their own discipline's GroupMember
// roster; PMM is roster-only (no extra permissions).
enum GroupRole {
  TEAM_LEADER
  SW_DM
  HW_DM
  ME_DM
  QA
  PMM
  PMD
  PM_DM
}

enum GroupDiscipline {
  SW
  HW
  ME
  QA
  PM
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MEMBER)
  avatarUrl    String?
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?

  /// 每小時人力成本(元)。null = 尚未設定,成本會照 0 算並在報表上點名。
  /// 放在使用者身上而不是設定頁:它跟著人的職級變動,不是一份全域參數。
  hourlyRate    Decimal? @db.Decimal(12, 2)
  /// 所屬單位 —— 人力成本與人力規劃都照這個歸戶。
  discipline    String?
  orgUnit       OrgUnit? @relation(fields: [discipline], references: [code], onDelete: SetNull, onUpdate: Cascade)
  /// 個人月薪。有填就蓋過所屬單位的標準月薪;時薪有填的話仍然優先,
  /// 換算順序見 labourRate.ts。
  monthlySalary Decimal? @db.Decimal(12, 2)

  weeklyReports WeeklyReport[]
  oauthCodes    OAuthCode[]
  oauthTokens   OAuthToken[]
  supervisorId  String?
  supervisor    User?          @relation("Supervision", fields: [supervisorId], references: [id], onDelete: SetNull)
  teamMembers   User[]         @relation("Supervision")

  ownedBoards             Board[]
  comments                Comment[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  assignments             Assignment[]
  automationNotifyFor     AutomationRule[]         @relation("RuleNotifyUser")
  boardMemberships        BoardMember[]
  attachments             Attachment[]
  itemLinks               ItemLink[]
  activityLogEntries      ActivityLogEntry[]
  createdItems            Item[]                   @relation("ItemCreatedBy")
  deletedItems            Item[]                   @relation("ItemDeletedBy")
  deletedBoards           Board[]                  @relation("BoardDeletedBy")
  labourSlots             LabourSlot[]             @relation("LabourSlotOwner")
  savedViews              SavedView[]              @relation("SavedViewOwner")
  projectTemplates        ProjectTemplate[]        @relation("ProjectTemplateCreatedBy")
  timeEntries             TimeEntry[]
  ownedRisks              RiskEntry[]              @relation("RiskOwner")
  visibleItems            ItemViewer[]
  leaves                  Leave[]
  visibleGroups           GroupViewer[]
  apiKeys                 ApiKey[]                 @relation("ApiKeyOwner")
  managedResources        Resource[]               @relation("ResourceManager")
  groupRoleAssignments    GroupRoleAssignment[]    @relation("GroupRoleAssignments")
  groupMemberships        GroupMember[]            @relation("GroupMembers")
  gateApprovals           GateApprover[]
  requestedChanges        ChangeRequest[]          @relation("ChangeRequester")
  decidedChanges          ChangeRequest[]          @relation("ChangeDecider")
  decidedTimeEntries      TimeEntry[]              @relation("TimeEntryDecider")
  decidedLeaves           Leave[]                  @relation("LeaveDecider")
  reserveDraws            ReserveDraw[]            @relation("ReserveDrawDecider")
  gateDecisions           Gate[]                   @relation("GateDecidedBy")
  reportRecipientFor      ProgramReportRecipient[]
}

// A non-login entity (tool, equipment, external vendor/supplier) that can be
// set as an item's 負責人 (PERSON column) alongside real Users, so tasks
// depending on them still have an accountable owner. Deliberately excluded
// from dashboards, workload calculations, and notifications, which only
// make sense for real staff.
model Resource {
  id        String   @id @default(cuid())
  name      String
  category  String?
  contact   String?
  note      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  managerId String?
  manager   User?   @relation("ResourceManager", fields: [managerId], references: [id], onDelete: SetNull)

  groupMemberships GroupResourceMember[]
}

model Board {
  id         String          @id @default(cuid())
  name       String
  ownerId    String
  owner      User            @relation(fields: [ownerId], references: [id])
  createdAt  DateTime        @default(now())
  visibility BoardVisibility @default(PUBLIC)

  progressColumnId String?
  progressColumn   Column? @relation("BoardProgressColumn", fields: [progressColumnId], references: [id], onDelete: SetNull)

  ganttStartColumnId    String?
  ganttStartColumn      Column?           @relation("BoardGanttStartColumn", fields: [ganttStartColumnId], references: [id], onDelete: SetNull)
  ganttDurationColumnId String?
  ganttDurationColumn   Column?           @relation("BoardGanttDurationColumn", fields: [ganttDurationColumnId], references: [id], onDelete: SetNull)
  ganttEndColumnId      String?
  ganttEndColumn        Column?           @relation("BoardGanttEndColumn", fields: [ganttEndColumnId], references: [id], onDelete: SetNull)
  ganttDurationMode     GanttDurationMode @default(CALENDAR)

  predColumnId String?
  predColumn   Column? @relation("BoardPredColumn", fields: [predColumnId], references: [id], onDelete: SetNull)
  linkColumnId String?
  linkColumn   Column? @relation("BoardLinkColumn", fields: [linkColumnId], references: [id], onDelete: SetNull)
  lagColumnId  String?
  lagColumn    Column? @relation("BoardLagColumn", fields: [lagColumnId], references: [id], onDelete: SetNull)
  typeColumnId String?
  typeColumn   Column? @relation("BoardTypeColumn", fields: [typeColumnId], references: [id], onDelete: SetNull)
  priorityColumnId String?
  priorityColumn   Column? @relation("BoardPriorityColumn", fields: [priorityColumnId], references: [id], onDelete: SetNull)

  // When both are set, Start/Days/Finish become read-only and are always
  // computed from these + Pred/Link/Lag — see resolveLockedScheduleFields.
  manualStartColumnId    String?
  manualStartColumn      Column? @relation("BoardManualStartColumn", fields: [manualStartColumnId], references: [id], onDelete: SetNull)
  manualDurationColumnId String?
  manualDurationColumn   Column? @relation("BoardManualDurationColumn", fields: [manualDurationColumnId], references: [id], onDelete: SetNull)

  reportStatusColumnId      String?
  reportStatusColumn        Column?  @relation("BoardReportStatusColumn", fields: [reportStatusColumnId], references: [id], onDelete: SetNull)
  reportNotStartedOptionIds String[] @default([])
  reportPlannedOptionIds    String[] @default([])
  reportPausedOptionIds     String[] @default([])
  reportStuckOptionIds      String[] @default([])
  reportDoneOptionIds       String[] @default([])

  levelColors String[] @default([])

  // Gantt task-name colors — app-wide (see SystemSettings), mirrored here on
  // write for the same reason levelColors is. Priority when an item matches
  // more than one: 完成 (done) beats 逾期 (overdue) beats 實作中 (in
  // progress); 尚未處理 (not started) gets no override, just the theme's
  // normal text color.
  ganttOverdueColor    String @default("#e2445c")
  ganttCompletedColor  String @default("#9ca3af")
  ganttInProgressColor String @default("#00c875")

  /// Pred lamp: predecessor done / still running / overdue.
  predReadyColor   String @default("#00c875")
  predWaitingColor String @default("#fdab3d")
  predBlockedColor String @default("#e2445c")

  /// When this board's baseline was last captured — null means it has none,
  /// so nothing is compared against a plan that was never saved.
  baselineCapturedAt DateTime?

  /// 垃圾桶。刪除看板不再是真的刪掉:有 deletedAt 的看板從每一份清單、搜尋、
  /// 排程網路與專案群組的計算裡消失,但整份資料都還在,可以還原。只有管理者
  /// 能永久刪除。
  deletedAt   DateTime?
  deletedById String?
  deletedBy   User?     @relation("BoardDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  groups          Group[]
  columns         Column[]         @relation("BoardColumns")
  items           Item[]
  automationRules AutomationRule[]
  members         BoardMember[]
  /// 專案群組:同一個群組裡的看板共用一張排程網路,前置可以跨看板,
  /// 要徑與完工日也是整個群組一起算。null = 這個看板自成一個專案。
  programId       String?
  program         Program?         @relation(fields: [programId], references: [id], onDelete: SetNull)

  savedViews     SavedView[]
  risks          RiskEntry[]
  gates          Gate[]
  changeRequests ChangeRequest[]
  activityLog    ActivityLogEntry[]
  webhooks       Webhook[]
  baselines      Baseline[]
  budgetPhases   BudgetPhase[]
  planMilestones PlanMilestone[]
  milestoneTypes MilestoneType[]
  labourSlots    LabourSlot[]
  protoPlans     ProtoPlan[]
  bomLines       BomLine[]

  @@index([deletedAt])
}

model BoardMember {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

model Group {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  color   String @default("#579bfc")
  order   Int    @default(0)

  visibility  RowVisibility @default(PUBLIC)
  viewers     GroupViewer[]
  /// Who made it private, and therefore keeps sight of it.
  createdById String?

  items                 Item[]
  automationMoveTargets AutomationRule[]
  roleAssignments       GroupRoleAssignment[]
  members               GroupMember[]
  resourceMembers       GroupResourceMember[]

  @@index([boardId])
}

// A user holding TEAM_LEADER or PMD for a Group can edit the schedule
// (Start/Days/Finish, Gantt drag) of any item in that group, regardless of
// their board-wide UserRole or item assignment — see canEditGanttItem's
// `hasGroupScheduleRole` param. SW_DM/HW_DM/ME_DM/QA instead act as a
// discipline-scoped supervisor (see GroupMember) with no schedule rights.
model GroupRoleAssignment {
  id      String    @id @default(cuid())
  groupId String
  group   Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role    GroupRole
  userId  String
  user    User      @relation("GroupRoleAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, role, userId])
  @@index([groupId, userId])
}

// The roster of users actually doing SW/HW/ME/QA work in a Group — this is
// what a matching discipline DM (see GroupRoleAssignment) is scoped to
// manage: item creation/assignment/progress for items assigned to these
// users, within this group only.
model GroupMember {
  id         String          @id @default(cuid())
  groupId    String
  group      Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  discipline GroupDiscipline
  userId     String
  user       User            @relation("GroupMembers", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, discipline, userId])
}

// Resources (tools/vendors, no login) rostered to a Group — informational
// only, mirrors GroupMember but grants no permissions since Resources can't
// authenticate.
model GroupResourceMember {
  id         String   @id @default(cuid())
  groupId    String
  group      Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([groupId, resourceId])
}

model Column {
  id      String     @id @default(cuid())
  boardId String
  board   Board      @relation("BoardColumns", fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  type    ColumnType
  options Json       @default("{}")
  order   Int        @default(0)

  cellValues              CellValue[]
  progressForBoards       Board[]          @relation("BoardProgressColumn")
  ganttStartForBoards     Board[]          @relation("BoardGanttStartColumn")
  ganttDurationForBoards  Board[]          @relation("BoardGanttDurationColumn")
  ganttEndForBoards       Board[]          @relation("BoardGanttEndColumn")
  predForBoards           Board[]          @relation("BoardPredColumn")
  linkForBoards           Board[]          @relation("BoardLinkColumn")
  lagForBoards            Board[]          @relation("BoardLagColumn")
  typeForBoards           Board[]          @relation("BoardTypeColumn")
  priorityForBoards       Board[]          @relation("BoardPriorityColumn")
  reportStatusForBoards   Board[]          @relation("BoardReportStatusColumn")
  manualStartForBoards    Board[]          @relation("BoardManualStartColumn")
  manualDurationForBoards Board[]          @relation("BoardManualDurationColumn")
  ruleTriggersFor         AutomationRule[] @relation("RuleTriggerColumn")
  ruleSetsFor             AutomationRule[] @relation("RuleSetColumn")

  @@index([boardId])
}

model Item {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    Item?    @relation("ItemSubitems", fields: [parentId], references: [id], onDelete: Cascade)
  subitems  Item[]   @relation("ItemSubitems")
  name      String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  constraintType ItemConstraintType?
  /// "YYYY-MM-DD", meaningless without a constraintType.
  constraintDate String?

  /// The saved plan this item is measured against — copied from its current
  /// Start/Finish/Days when the board's baseline is captured, then left alone
  /// while the real dates move. Null until a baseline exists.
  baselineStart String?
  baselineEnd   String?
  baselineDays  Int?

  /// 直接費用(NRE、BOM、外包…),與人力成本分開記:一個是買來的,一個是
  /// 做出來的,混在一起就分不出超支的是料還是工。
  ///
  /// 整數元,不是 Decimal:這兩個值會跟著 board.items 一路傳到 client
  /// component,而 Decimal 是類別實例、過不了那個邊界;報價本來也都是整數元。
  budgetCost Int?
  actualCost Int?

  /// The Type option this item had before gaining its first child forced it
  /// to Summary, so removing the last child can put it back. "" means it had
  /// no Type at all; null means it was never flipped.
  typeBeforeSummary String?

  visibility RowVisibility @default(PUBLIC)
  viewers    ItemViewer[]

  createdById String?
  createdBy   User?   @relation("ItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// Set when the item is put in the trash. Every read path filters on
  /// deletedAt: null — a trashed item is gone from the board, the schedule
  /// and every report, but its comments, files and history are still there
  /// waiting for a restore.
  deletedAt           DateTime?
  deletedById         String?
  deletedBy           User?     @relation("ItemDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  /// What the dependents' Pred cells held before this deletion rewrote them,
  /// as [{itemId, columnId, value}] — restoring the item has to put their
  /// dependencies back too, or the undo is only half an undo.
  deletedPredSnapshot Json?

  cellValues    CellValue[]
  comments      Comment[]
  notifications Notification[]
  assignments   Assignment[]
  attachments   Attachment[]
  links         ItemLink[]
  activityLog   ActivityLogEntry[]
  todoItems     TodoItem[]
  timeEntries   TimeEntry[]
  budgets       Budget[]
  commitments   Commitment[]
  expenses      Expense[]
  reserves      Reserve[]

  @@index([boardId])
  @@index([groupId])
  @@index([parentId])
  @@index([boardId, deletedAt])
}

model Attachment {
  id           String      @id @default(cuid())
  /// Always set, even for a receipt attached to an expense: it is what the
  /// download route checks board access through, and where the file is
  /// stored on disk.
  itemId       String
  item         Item        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 報價單、發票、簽了的 PO。設了其中一個,這個檔案就是那筆帳的憑證,
  /// 而不是工作項本身的附件——項目卡片的附件清單會把它們排除。
  expenseId    String?
  expense      Expense?    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  commitmentId String?
  commitment   Commitment? @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  fileName     String
  url          String
  size         Int
  uploaderId   String
  uploader     User        @relation(fields: [uploaderId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([itemId])
  @@index([expenseId])
  @@index([commitmentId])
}

/// 工作項底下的外部連結(雲端硬碟、Google Sheet、外部文件……)——跟附件是
/// 兩回事:附件是上傳進系統的檔案本體,這裡存的只是網址,不佔儲存空間。
model ItemLink {
  id          String   @id @default(cuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  url         String
  /// 使用者自己取的顯示名稱。沒填就顯示網址本身。
  label       String?
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([itemId])
}

/// 稽核事件的分類。工作項的改動是原本就有的那一類;其餘是這次補上的——
/// 費率、基準線、可見範圍、看板刪除這些「管錢跟管承諾」的操作,以前反而
/// 一筆都沒留。
enum AuditCategory {
  ITEM
  BOARD
  BASELINE
  VISIBILITY
  /// 費率與預算。
  COST
  SETTINGS
  /// 帳號、角色、分組權限。
  ACCESS
  GATE
  CHANGE
  /// 工時與請假的審核。
  APPROVAL
}

model ActivityLogEntry {
  id        String        @id @default(cuid())
  /// 工作項層級的事件。板級/系統級事件沒有工作項,所以可為 null。
  itemId    String?
  item      Item?         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  /// 事件屬於哪個看板。工作項事件也填,這樣稽核頁不必為了篩選看板而回頭
  /// 查每一筆的工作項。系統層級的事件為 null。
  boardId   String?
  board     Board?        @relation(fields: [boardId], references: [id], onDelete: SetNull)
  category  AuditCategory @default(ITEM)
  actorId   String?
  actor     User?         @relation(fields: [actorId], references: [id], onDelete: SetNull)
  message   String
  createdAt DateTime      @default(now())

  @@index([itemId])
  @@index([boardId, createdAt])
  @@index([category, createdAt])
}

model TodoItem {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([itemId])
}

model Assignment {
  id            String @id @default(cuid())
  itemId        String
  item          Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId        String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocationPct Int    @default(100)

  @@unique([itemId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([itemId])
}

enum NotificationType {
  ASSIGNED
  UPDATED
  COMMENTED
  AUTOMATION
  /// 新增與刪除一列。收件人比其他幾種廣:同一個分組的人都會收到,因為
  /// 結構變動影響的是整張排程網路,不只被指派的那個人。
  CREATED
  DELETED
}

model AutomationRule {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String

  triggerColumnId String
  triggerColumn   Column @relation("RuleTriggerColumn", fields: [triggerColumnId], references: [id], onDelete: Cascade)
  triggerValue    String

  notifyUserId String?
  notifyUser   User?   @relation("RuleNotifyUser", fields: [notifyUserId], references: [id], onDelete: SetNull)

  setColumnId String?
  setColumn   Column? @relation("RuleSetColumn", fields: [setColumnId], references: [id], onDelete: SetNull)
  setValue    Json?

  moveToGroupId String?
  moveToGroup   Group?  @relation(fields: [moveToGroupId], references: [id], onDelete: SetNull)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  type      NotificationType
  itemId    String
  item      Item             @relation(fields: [itemId], references: [id], onDelete: Cascade)
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([itemId])
}

/// 一個人對某一種通知類型的偏好——站內要不要收、email 要不要寄。沒有這筆
/// 紀錄代表還沒特別設定過,各類型各自的預設值在 notify.ts 的
/// DEFAULT_IN_APP / DEFAULT_EMAIL 裡,跟改這個功能之前的既有行為一致。
model NotificationPreference {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  inApp     Boolean          @default(true)
  email     Boolean          @default(false)
  updatedAt DateTime         @updatedAt

  @@unique([userId, type])
}

model WorkloadThreshold {
  id          String   @id @default("global")
  greenMax    Int      @default(30)
  yellowMax   Int      @default(70)
  greenColor  String   @default("#00c875")
  yellowColor String   @default("#fdab3d")
  redColor    String   @default("#e2445c")
  updatedAt   DateTime @updatedAt
}

// App-wide settings an ADMIN controls from /settings. Defaults to email
// notifications OFF — the site isn't public yet and nobody should get an
// email until an admin deliberately turns it on. levelColors/
// ganttDurationMode used to be per-Board fields; they're app-wide now, so a
// write here also broadcasts to every Board's own copy of the field (kept
// only so the many existing per-board reads don't need to change).
/// 預算表自己的一組階段起訖日。
///
/// 刻意跟看板上那幾列階段的 Start/Finish 分開:預算表是初期評估,做的時候
/// 實際時程還不存在,之後也一定會有落差 —— 而那個落差正是要看的東西。
/// itemId 對上看板那一列之後,就比得出「當初排幾天 vs 現在要幾天」。
model BudgetPhase {
  id        String  @id @default(cuid())
  boardId   String
  board     Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name      String
  /// "YYYY-MM-DD"。
  startDate String
  endDate   String
  /// 對應到看板上的哪一列階段。null = 純預算階段,不比較時程。
  itemId    String?
  /// 帶的顏色。同色的話,兩個相鄰的階段在時間軸上會糊成一條。
  color     String  @default("#fdab3d")
  order     Int

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  protoPlans  ProtoPlan[]
  budgets     Budget[]
  reserves    Reserve[]
  labourPlans LabourPlan[]
  bomLines    BomLine[]

  @@index([boardId, order])
}

/// 里程碑區間:軟體、硬體 PCBA 打件、機構出圖、認證、測試、demo 樣機……
/// 有起也有迄,所以是一條帶,不是看板上 Type=Milestone 那種單一日期的點。
/// track 讓它們分列排,就像那張 Excel 的「SW milestones」「Key Milestone」兩列。
/// 里程碑類型,例如「軟體」「機構」「key part 備料」。
///
/// 同一個類型的里程碑排在同一排 —— 類型就是那一排的名字。每塊看板自己一
/// 份:M3 的「key part 備料」跟充電站的不是同一件事。
model MilestoneType {
  id      String @id @default(cuid())
  boardId String
  board   Board  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  name    String
  order   Int

  milestones PlanMilestone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, name])
  @@index([boardId, order])
}

model PlanMilestone {
  id        String        @id @default(cuid())
  boardId   String
  board     Board         @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 排在哪一排。類型底下的里程碑彼此重疊才會再往下長。
  typeId    String
  type      MilestoneType @relation(fields: [typeId], references: [id], onDelete: Restrict)
  name      String
  startDate String
  endDate   String
  color     String        @default("#fdab3d")
  order     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([boardId, typeId, order])
}

/// 一個人力名額,也就是那張 Excel 裡的一列(EE1、SW3、ME2……)。
///
/// 名額而不是人:預算階段常常還沒招到人,那一列就掛 TBH。指到人之後,
/// userId 有值,ownerLabel 留著寫「TBH (Jason 代)」這種註記。
model LabourSlot {
  id          String  @id @default(cuid())
  boardId     String
  board       Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  discipline  String
  orgUnit     OrgUnit @relation(fields: [discipline], references: [code], onDelete: Restrict, onUpdate: Cascade)
  /// 名額代號,EE1、SW3。
  label       String
  /// 職能,EEDM、driver、web、PQA……比單位細一層。
  func        String  @default("")
  /// 指定的人。null = 還沒指定。
  userId      String?
  user        User?   @relation("LabourSlotOwner", fields: [userId], references: [id], onDelete: SetNull)
  /// 沒指定人時寫在負責人欄的字,例如「TBH」「TBH (Jason 代)」。
  ownerLabel  String  @default("")
  description String  @default("")
  order       Int

  months LabourSlotMonth[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boardId, order])
}

/// 某個名額某個月投入多少 —— 1 = 整個月全職,0.5 = 半個月。加總就是人月。
model LabourSlotMonth {
  id     String     @id @default(cuid())
  slotId String
  slot   LabourSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  /// "YYYY-MM"。
  month  String
  fte    Decimal    @db.Decimal(5, 2)

  @@unique([slotId, month])
}

/// 樣機使用計畫:某個產品、某個階段、某個用途單位,要用掉幾台。
///
/// 跟人力表同一個道理 —— EVT 兩台給 SW 做 mock up、DVT1 三台給 QA-Rel,
/// 這些數字談出來之後才知道要備多少料。用途單位比人力的 OrgUnit 廣:
/// field test、sale department、marketing、工廠 golden sample 都會吃樣機,
/// 但那些不是工程單位,所以是自由文字而不是列舉。
model ProtoPlan {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 哪個產品。同一個看板可能同時排 M3 與充電站兩套。
  product String
  /// 用途單位,例如 HW-EE、SW、QA-Rel、Field test - US、Factory。
  unit    String
  /// 對應到 BudgetPhase 那一列。階段一刪,它的樣機數也跟著走。
  phaseId String
  phase   BudgetPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  /// 幾台。
  qty     Int
  /// 備註,例如「mock up」。
  note    String      @default("")

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([boardId, product, unit, phaseId])
  @@index([boardId, product])
}

/// 樣機 BOM:某個產品、某個階段,一台裝置要用哪些料。
///
/// 一個階段一份,不是一張表標三個階段的價錢 —— EVT 用的是工程樣品,DVT
/// 換成量產件,PVT 又不一樣,同一個位置在三個階段可能是三個料號、三個廠商、
/// 三個價錢。硬塞成一張表就沒辦法回答「DVT 那一版貴在哪裡」。
///
/// 多層:一列可以是「子集」(電池模組、主機板),底下再掛它自己的零件。
/// 有子項目的那一列不填單價 —— 它的價錢是底下加起來的,兩邊都填就會有
/// 一個永遠對不起來的數字,而且沒人知道該信哪一個。
model BomLine {
  id      String      @id @default(cuid())
  boardId String
  board   Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 哪個產品。跟樣機計畫同一組名字(M3、充電站)。
  product String
  /// 哪個階段。階段一刪,它的 BOM 也跟著走。
  phaseId String
  phase   BudgetPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  /// 上一層的子集。null = 最上層。
  parentId String?
  parent   BomLine?  @relation("BomTree", fields: [parentId], references: [id], onDelete: Cascade)
  children BomLine[] @relation("BomTree")

  /// 品名。
  name         String
  /// 廠商。
  vendor       String  @default("")
  /// 型號 / 料號。
  partNumber   String  @default("")
  /// 上一層要用幾個。最上層就是一台裝置要幾個;在子集底下就是那個子集裡要幾個。
  qty          Decimal @db.Decimal(12, 3)
  /// 單價,幣別由 currency 決定。有子項目的列填了也不算 —— 價錢從底下加上來。
  unitPrice    Decimal @db.Decimal(14, 4)
  currency     String  @default("TWD")
  /// 換算台幣的匯率,凍結在填的當下 —— 跟訂單同一個道理,事後匯率變了不該
  /// 讓半年前談好的那顆零件變貴。
  fxRate       Decimal @db.Decimal(12, 6)
  note         String  @default("")
  /// 預估交期,不影響金額計算,只是排期用。沒填就是還不知道。
  deliveryDate String? // "YYYY-MM-DD"
  order        Int

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boardId, product, phaseId, order])
  @@index([parentId])
}

/// 公司組織單位。人力成本、人力預算、樣機用途都按這個分,因為「這個階段
/// 要花多少錢」在 NPI 裡實際上是「EE 幾個人月、ME 幾個人月」談出來的。
///
/// 是資料表而不是列舉:公司會新增單位(FAE、NPI、Sourcing……),那是設定,
/// 不該每次都要改 schema。code 是代號(EE),label 是顯示用的全名。
model OrgUnit {
  code  String @id
  label String
  /// 排序。表格的欄位順序、下拉選單的順序都照這個。
  order Int    @default(0)

  users User[]
  rate  DisciplineRate?
  plans LabourPlan[]
  slots LabourSlot[]

  @@index([order])
}

/// 各單位的標準月薪。編預算的時候還不知道會是誰做,所以人力規劃一律用
/// 單位的標準價;實際成本才用到人身上的費率。
model DisciplineRate {
  discipline    String   @id
  orgUnit       OrgUnit  @relation(fields: [discipline], references: [code], onDelete: Restrict, onUpdate: Cascade)
  /// 元/月。
  monthlySalary Int
  updatedAt     DateTime @updatedAt
}

/// 一個階段要用掉某個單位幾個人月。階段 × 單位交叉起來就是人力規劃表,
/// 它加總起來就是這個階段的人力預算 —— 所以人力那一列不是手填的金額,
/// 而是這張表算出來的。
///
/// 掛在階段那一列工作項上,跟 Budget 一樣的錨點。
model LabourPlan {
  id           String      @id @default(cuid())
  /// 掛在預算階段上,不是看板工作項:一個階段就是一段要編人力的計畫,
  /// 而兩個階段可以對到看板上同一列(DVT1、DVT2 → DVT),掛在工作項上
  /// 的話那兩段會擠成一筆。
  phaseId      String
  phase        BudgetPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  discipline   String
  orgUnit      OrgUnit     @relation(fields: [discipline], references: [code], onDelete: Restrict, onUpdate: Cascade)
  /// 人月,允許到小數點兩位(0.5 個人月是常見的寫法)。
  personMonths Decimal     @db.Decimal(8, 2)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phaseId, discipline])
}

model SystemSettings {
  id                        String             @id @default("global")
  emailNotificationsEnabled Boolean            @default(false)
  /// 這套系統要啟用哪些通知類型——關掉的話,不管使用者個人設定怎麼選,
  /// 那個類型的通知(站內與 email)都不會產生。
  enabledNotificationTypes  NotificationType[] @default([ASSIGNED, UPDATED, COMMENTED, AUTOMATION, CREATED, DELETED])
  levelColors               String[]           @default([])
  ganttDurationMode         GanttDurationMode  @default(BUSINESS)
  ganttOverdueColor         String             @default("#e2445c")
  ganttCompletedColor       String             @default("#9ca3af")
  ganttInProgressColor      String             @default("#00c875")
  predReadyColor            String             @default("#00c875")
  predWaitingColor          String             @default("#fdab3d")
  predBlockedColor          String             @default("#e2445c")
  /// 一天算幾小時 — 把「配置 50%、做 10 天」換算成工時與成本的那個係數。
  hoursPerDay               Int                @default(8)
  /// 一個人月算幾個工作天 — 把月薪換算成時薪、把人月換算成工時的係數。
  workingDaysPerMonth       Int                @default(21)
  /// 新看板要帶哪些欄位:[{ name, type, options }],順序就是欄位順序。
  /// Null means nobody has set one, and a new board falls back to the built-in
  /// list — the same one this used to be, hardcoded.
  defaultColumns            Json?
  /// 專案週報分發的排程時間。enabled 是總開關;dow 是星期幾(0=週日,
  /// 沿用 JS Date.getDay() 的編號,1=週一)。
  weeklyReportEnabled       Boolean            @default(false)
  weeklyReportDow           Int                @default(1)
  weeklyReportHour          Int                @default(6)
  weeklyReportMinute        Int                @default(0)
  /// 這週跑過了沒——存 ISO 週字串("2026-W39"),不是時間戳記,拿「這週
  /// 有沒有跑過」判斷,不用擔心 tick 間隔或時區把「跨過某個時刻」算錯。
  weeklyReportLastRunWeek   String?
  /// 資料庫備份的排程時間——同一套設計:enabled 總開關,frequency 決定
  /// dow 要不要比對("DAILY" 不比對,"WEEKLY" 才比對)。
  backupEnabled             Boolean            @default(false)
  backupFrequency           String             @default("DAILY")
  backupDow                 Int                @default(1)
  backupHour                Int                @default(3)
  backupMinute              Int                @default(0)
  /// 超過幾天的備份自動清除——預設值跟 scripts/backup-db.sh 的
  /// RETENTION_DAYS 預設一致。
  backupRetentionDays       Int                @default(60)
  /// 上次成功備份的日期("YYYY-MM-DD")——跟 weeklyReportLastRunWeek 同一個
  /// 判斷邏輯,只是改成「今天跑過了沒」,DAILY/WEEKLY 共用同一個欄位。
  backupLastRunDate         String?
  updatedAt                 DateTime           @updatedAt
}

// Company-wide (not per-board) list of dates that business-day duration
// calculations should skip in addition to weekends.
model Holiday {
  id   String @id @default(cuid())
  date String @unique // "YYYY-MM-DD"
  name String
}

model CellValue {
  id       String @id @default(cuid())
  itemId   String
  item     Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  columnId String
  column   Column @relation(fields: [columnId], references: [id], onDelete: Cascade)
  value    Json   @default("null")

  @@unique([itemId, columnId])
}

/// A named set of filters someone got tired of re-entering — "我的逾期任務",
/// "本週要交的". Private to its owner unless shared with the board.
model SavedView {
  id        String   @id @default(cuid())
  boardId   String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  ownerId   String
  owner     User     @relation("SavedViewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  name      String
  /// Visible to everyone who can open the board; only the owner can change it.
  isShared  Boolean  @default(false)
  /// { filters: ActiveFilter[], groupFilterId: string, searchQuery: string }
  /// — see parseViewConfig, which is what actually decides what is usable.
  config    Json
  createdAt DateTime @default(now())

  @@index([boardId, ownerId])
}

/// The shape of a phase — POC → EVT → PVT — captured from a group that
/// already ran, so the next project does not have to be typed in again.
/// App-wide, not per board: the point is to reuse it on the next board.
model ProjectTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdById String?
  createdBy   User?    @relation("ProjectTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  /// The captured tree — see buildTemplateContent / parseTemplateContent.
  /// Columns are held by name and dependencies by position, so a template
  /// is not tied to the board it came from.
  content     Json
  createdAt   DateTime @default(now())
}

enum RiskKind {
  /// Something that has not happened yet, and might not.
  RISK
  /// Something that already has.
  ISSUE
}

enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
}

/// The Risk/Issue register: what could go wrong, how bad it would be, who is
/// dealing with it. Deliberately separate from Item — a risk is not a task on
/// the schedule, and putting it there would put it on the critical path.
model RiskEntry {
  id             String     @id @default(cuid())
  boardId        String
  board          Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  kind           RiskKind   @default(RISK)
  status         RiskStatus @default(OPEN)
  title          String
  description    String?
  /// 1-5 each; the register sorts on their product — see riskScore.
  probability    Int        @default(3)
  impact         Int        @default(3)
  /// 發生的話要多少錢(元)。沒填就算不出 EMV,那一筆只會有 1-5 的分數。
  costImpact     Int?
  /// 機率的百分比。填了就用它算 EMV,沒填就用 probability 這一級推算——
  /// 「中等機率」要換成一個數字才乘得下去,而那個換算值本來就該講明白。
  probabilityPct Int?
  /// The countermeasure, and who owes it.
  mitigation     String?
  ownerId        String?
  owner          User?      @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  /// "YYYY-MM-DD" — when the countermeasure is due, not when the risk hits.
  dueDate        String?
  /// The work item this is about, when there is one. Kept as a plain id
  /// rather than a relation: trashing the item must not take the risk with
  /// it — the risk is often the reason the item is being reworked.
  itemId         String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boardId, status])
}

/// A key for the read-only REST API. Only the hash is stored — a key that
/// can be read back out of the database is a key that leaks with a backup.
/// It carries its creator's board access rather than a permission model of
/// its own: the API can never show more than the person who issued the key.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  hashedKey  String    @unique
  /// The visible head of the key ("hrapp_1a2b3c…"), so a key can be told
  /// apart in the list without storing the rest of it.
  prefix     String
  ownerId    String
  owner      User      @relation("ApiKeyOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

/// An outgoing HTTP callback for board events. Each delivery is signed with
/// the webhook's own secret so the receiver can tell a real one from anybody
/// who learned the URL.
model Webhook {
  id            String    @id @default(cuid())
  boardId       String
  board         Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  url           String
  secret        String
  /// "item.created" | "item.updated" | "item.deleted"
  events        String[]  @default([])
  active        Boolean   @default(true)
  /// Enough of a delivery log to debug a silent integration, without a
  /// second table filling up with every event ever sent.
  lastStatus    Int?
  lastError     String?
  lastAttemptAt DateTime?
  createdAt     DateTime  @default(now())

  @@index([boardId])
}

/// One person's hours on one item on one day — the actual, against which
/// the planned allocationPct is only ever an estimate.
/// 送審狀態。核准前不算數:未核准的工時不會進 EVM 的實際成本,未核准的
/// 請假也不會改變產能判定——否則「已登記」就等於「已成立」,審核只是裝飾。
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model TimeEntry {
  id           String         @id @default(cuid())
  itemId       String
  item         Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD" — the day worked, not the day it was typed in.
  date         String
  hours        Decimal        @db.Decimal(6, 2)
  note         String?
  status       ApprovalStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?          @relation("TimeEntryDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime       @default(now())

  @@index([itemId])
  @@index([userId, date])
  @@index([status])
}

/// A saved plan, kept whole.
///
/// The board's Item.baselineStart/End/Days stay as the *active* baseline —
/// every existing reader (甘特圖長條、項目卡片、S 曲線、EVM 的 PV) keeps
/// working unchanged — and this table is the archive those values are
/// copied from and to. Re-capturing no longer destroys the previous plan:
/// "跟三月那版比" is the question a baseline exists to answer, and until now
/// the answer was gone the moment somebody re-planned.
model Baseline {
  id             String          @id @default(cuid())
  boardId        String
  board          Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 使用者取的名字, e.g. "EVT 啟動版"; defaults to the capture date.
  name           String
  capturedAt     DateTime        @default(now())
  capturedById   String?
  /// How many items had resolvable dates when it was taken.
  itemCount      Int             @default(0)
  entries        BaselineEntry[]
  /// 哪些變更單是靠這一版基準線落地的 — 「為什麼日期變了」的答案。
  changeRequests ChangeRequest[]

  @@index([boardId, capturedAt])
}

/// One item's dates within one saved baseline.
model BaselineEntry {
  id         String   @id @default(cuid())
  baselineId String
  baseline   Baseline @relation(fields: [baselineId], references: [id], onDelete: Cascade)
  /// Plain id, not a relation: a baseline outlives the items in it, and an
  /// item that has since been deleted should not delete the plan's record
  /// that it was once scheduled.
  itemId     String
  start      String?
  end        String?
  days       Int?

  @@unique([baselineId, itemId])
}

/// One person allowed to see one private 工作項.
model ItemViewer {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

/// One person allowed to see one private 分組.
model GroupViewer {
  id      String @id @default(cuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

/// 個人休假. Holiday is company-wide; this is one person being away.
///
/// It does NOT move the schedule: the scheduling engine deliberately knows
/// nothing about who is doing the work, and making dates depend on one
/// person's leave would mean the same task showing different dates as soon
/// as it is reassigned. What it does is tell the workload views that this
/// person has no capacity those days.
model Leave {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// "YYYY-MM-DD", both inclusive.
  startDate    String
  endDate      String
  reason       String?
  status       ApprovalStatus @default(PENDING)
  decidedById  String?
  decidedBy    User?          @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime       @default(now())

  @@index([userId, startDate])
  @@index([status])
}

/// 一組一起交付的看板 —— POC 看板、EVT 看板、PVT 看板同屬一個「AMR 平台」。
///
/// 它存在的理由只有一個:讓「專案」有一個比看板大的邊界,好讓跨看板的前置、
/// 一條共同的要徑、一個共同的完工日有對象可言。
/// 階段閘門的狀態。NPI 是閘門式的:DVT 沒過不能進 PVT,而"過"是一個
/// 有人負責、有時間、有理由的決定,不是一個勾選框。
enum GateStatus {
  /// 還在準備,條件還沒補齊。
  DRAFT
  /// 已送審,等簽核人表態。
  PENDING
  /// 通過放行。
  PASSED
  /// 不通過,要補件重送。
  FAILED
  /// 有條件放行:必要條件沒有全過,但決定往下走。理由必填——
  /// 這是整個機制裡唯一值得事後翻出來看的一筆。
  WAIVED
}

enum GateDecision {
  APPROVED
  REJECTED
}

/// 一個階段的出口閘門。掛在階段那一列工作項上(例如「EVT Phase」),
/// 因為放行與否講的是那個階段,不是某一張表。
model Gate {
  id           String     @id @default(cuid())
  boardId      String
  board        Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 這個閘門收尾的階段。可為 null:有些閘門(例如 MRD 凍結)不屬於任何
  /// 一個階段列。刪掉那一列不該連帶刪掉簽核紀錄,所以存純 id。
  itemId       String?
  name         String
  status       GateStatus @default(DRAFT)
  /// "YYYY-MM-DD" 預計審查日。
  plannedDate  String?
  /// 誰、什麼時候、為什麼下了最後那個決定。
  decidedAt    DateTime?
  decidedById  String?
  decidedBy    User?      @relation("GateDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decisionNote String?

  criteria  GateCriterion[]
  approvers GateApprover[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([boardId, status])
}

/// 一條進出條件。required 的沒有全部達成就不能 PASSED,只能 WAIVED。
model GateCriterion {
  id       String  @id @default(cuid())
  gateId   String
  gate     Gate    @relation(fields: [gateId], references: [id], onDelete: Cascade)
  text     String
  required Boolean @default(true)
  met      Boolean @default(false)
  /// 佐證的工作項,有的話。同樣存純 id。
  itemId   String?
  order    Int     @default(0)

  @@index([gateId])
}

/// 一位簽核人。每個人各自表態,缺一個就還沒過。
model GateApprover {
  id        String        @id @default(cuid())
  gateId    String
  gate      Gate          @relation(fields: [gateId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// null = 還沒表態。
  decision  GateDecision?
  decidedAt DateTime?
  comment   String?

  @@unique([gateId, userId])
  @@index([gateId])
}

/// 變更單的生命週期。
enum ChangeStatus {
  DRAFT
  /// 已送出,等核准。
  SUBMITTED
  /// 核准了,但還沒動到計畫。
  APPROVED
  REJECTED
  /// 已執行 — 通常伴隨重新建立基準線。
  IMPLEMENTED
  /// 提出的人自己收回。
  WITHDRAWN
}

/// 一張工程變更單(ECR)。
///
/// 基準線已經留得住「日期變成什麼樣」,留不住「為什麼變、誰批准、預期影響
/// 多少」。三個月後爭的都是後面那三件事,所以這裡才是要寫下來的地方。
model ChangeRequest {
  id          String       @id @default(cuid())
  boardId     String
  board       Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// 看板內的流水號,顯示成 CR-001。
  number      Int
  title       String
  /// 改什麼。
  description String?
  /// 為什麼要改。整張單子三個月後只有這一欄有人會回來看。
  reason      String?
  status      ChangeStatus @default(DRAFT)

  /// 影響評估:提出時的預估,不是事後的實際值。
  scheduleImpactDays Int?
  /// 元,與 Item.budgetCost 同單位。
  costImpact         Int?
  impactNote         String?

  /// 受影響的工作項。存純 id:工作項被丟進垃圾桶不該把變更紀錄一起帶走。
  itemIds String[] @default([])

  requestedById String?
  requestedBy   User?     @relation("ChangeRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedById   String?
  decidedBy     User?     @relation("ChangeDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt     DateTime?
  decisionNote  String?

  /// 執行這次變更時建立的那一版基準線。把「為什麼」接到「結果」。
  baselineId String?
  baseline   Baseline? @relation(fields: [baselineId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, number])
  @@index([boardId, status])
}

/// 費用類別。預算按類別核准,花費也按類別記,才看得出是哪一類爆掉。
enum CostCategory {
  /// 人力。不必手動記帳——由核准過的工時 × 時薪自動算出。
  LABOUR
  MATERIAL
  TOOLING
  OUTSOURCING
  TRAVEL
  OTHER
}

/// 一筆核准預算:由上而下的那個數字。
///
/// 跟 Item.budgetCost 不同,那是由下而上、每個工作項各自估的,拿來算 CPI
/// 「做掉的事有沒有比估的貴」。這裡的是「這個階段/這個專案總共核准多少錢」,
/// 拿來回答「還剩多少可以花」——兩個問題不一樣,所以兩份數字並存。
model Budget {
  id        String       @id @default(cuid())
  /// 恰好其中一個有值:預算階段、看板上的一列工作項,或整個專案群組。
  ///
  /// phaseId 是現在的主軸:預算是「計畫」,而計畫的單位是預算階段 ——
  /// DVT1 與 DVT2 是兩段各自要編預算的計畫,即使它們對到看板上同一列。
  /// 實際花費(Expense/Commitment)仍然掛在看板工作項上,因為錢是花在真正
  /// 做的事情上;兩邊分開才比得出「估的」與「花的」差多少。
  ///
  /// itemId 留著給沒有建預算階段的看板沿用,語意不變。
  phaseId   String?
  phase     BudgetPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  programId String?
  program   Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)

  category CostCategory
  /// 元。
  amount   Int
  note     String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phaseId, category])
  @@unique([itemId, category])
  @@unique([programId, category])
}

/// 已下單未入帳。
///
/// PO 一簽,錢實質上已經花掉了,但發票還沒進來——實際成本看不到它。少了這一
/// 欄,「還剩多少可用」會一路高估到發票到齊那天,而那天通常已經來不及。
model Commitment {
  id     String @id @default(cuid())
  /// 這筆訂單掛在哪一列工作項上(可以是階段那一列,也可以是底下某個任務)。
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  category       CostCategory
  /// 換算後的台幣金額,凍結在下單當下。所有加總都用這一欄。
  amount         Int
  /// 幣別。TWD 時 originalAmount 就等於 amount、fxRate 是 1。
  currency       String       @default("TWD")
  /// 外幣原始金額 — 報價單上寫的那個數字。
  originalAmount Int          @default(0)
  /// 記帳當下的匯率,凍結。之後匯率再怎麼動,這一筆的台幣金額不變。
  fxRate         Decimal      @default(1) @db.Decimal(12, 4)
  vendor         String?
  poNumber       String?
  /// "YYYY-MM-DD" 預計到貨或入帳日。
  expectedDate   String?
  /// 入帳之後就不再算進「已承諾」——那筆錢已經變成實際支出了。
  settled        Boolean      @default(false)
  settledAt      DateTime?
  note           String?

  attachments Attachment[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([itemId, settled])
}

/// 一筆實際支出。
///
/// 記在分組(階段)上,需要的話再連到某個工作項。往上一路 group → board →
/// program,所以階段預算和群組預算讀的是同一本帳,不必記兩次。
///
/// 人力不走這裡:它由核准過的工時算出來,手動再記一次就會重複計算。
model Expense {
  id     String @id @default(cuid())
  /// 這筆錢花在哪一列工作項上。階段層的支出(例如整個 EVT 的差旅)就掛在
  /// 階段那一列。
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  category       CostCategory
  /// 換算後的台幣金額,凍結在記帳當下。所有加總都用這一欄。
  amount         Int
  /// 幣別。TWD 時 originalAmount 就等於 amount、fxRate 是 1。
  currency       String       @default("TWD")
  /// 外幣原始金額 — 報價單上寫的那個數字。
  originalAmount Int          @default(0)
  /// 記帳當下的匯率,凍結。之後匯率再怎麼動,這一筆的台幣金額不變。
  fxRate         Decimal      @default(1) @db.Decimal(12, 4)
  /// "YYYY-MM-DD" 發生日,不是輸入日。
  date           String
  vendor         String?
  note           String?
  /// 這筆支出結清的是哪一張 PO,有的話。
  commitmentId   String?

  attachments Attachment[]

  createdById String?
  createdAt   DateTime @default(now())

  @@index([itemId, date])
}

/// 匯率表。
///
/// 只用來預填輸入框——實際換算用的永遠是每一筆自己存下來的 fxRate。匯率天天
/// 在動,如果總額跟著今天的匯率浮動,上個月結的帳下個月就會變成另一個數字。
/// 這張表同時也是「系統有哪些幣別」的清單;台幣是基準幣別,不在裡面。
model ExchangeRate {
  /// ISO 代碼,例如 "USD"。
  code        String   @id
  /// 1 單位外幣等於多少台幣。
  rate        Decimal  @db.Decimal(12, 4)
  updatedAt   DateTime @updatedAt
  updatedById String?
}

/// 準備金的兩種。分開是因為動用它們的授權層級不一樣。
enum ReserveKind {
  /// 應變準備金:留給「已知會有風險、只是不知道會不會發生」的那些事。
  /// 專案負責人可以動支。
  CONTINGENCY
  /// 管理準備金:留給想都沒想到的事。通常要更高層才動得了。
  MANAGEMENT
}

/// 一筆準備金。跟核准預算掛在同一層:階段各自一筆,專案群組也可以有自己的。
///
/// 它不是一個可以直接花的類別 —— 錢要先「動支」撥進某個類別才花得出去
/// (見 ReserveDraw)。少了這一層,「還剩 20 萬」就分不出那是可以花的錢,
/// 還是本來就該留著的緩衝。
model Reserve {
  id        String       @id @default(cuid())
  phaseId   String?
  phase     BudgetPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?        @relation(fields: [itemId], references: [id], onDelete: Cascade)
  programId String?
  program   Program?     @relation(fields: [programId], references: [id], onDelete: Cascade)

  kind   ReserveKind
  /// 元。核准的原始額度,動支不會改這個數字——餘額是它減掉動支。
  amount Int
  note   String?

  draws ReserveDraw[]

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([phaseId, kind])
  @@unique([itemId, kind])
  @@unique([programId, kind])
}

/// 一次動支:把準備金撥進某個費用類別。
///
/// 撥款會同步把該類別的核准預算加上同一個金額,所以總額不變——動支是搬錢,
/// 不是生錢。理由必填:準備金被花掉的原因,是事後唯一有人會回來看的東西。
model ReserveDraw {
  id        String  @id @default(cuid())
  reserveId String
  reserve   Reserve @relation(fields: [reserveId], references: [id], onDelete: Cascade)

  /// 撥給哪一個費用類別。
  category CostCategory
  amount   Int
  reason   String

  decidedById String?
  decidedBy   User?    @relation("ReserveDrawDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([reserveId])
}

model Program {
  id                 String                     @id @default(cuid())
  name               String
  /// 誰建立的。預算編輯權要認「專案建立者」,群組層得有個對象可以認。
  /// 這個欄位之前建立的群組是 null,那些就只有管理者能編。
  createdById        String?
  createdAt          DateTime                   @default(now())
  boards             Board[]
  budgets            Budget[]
  reserves           Reserve[]
  reportSubscription ProgramReportSubscription?
  reportSnapshots    ProgramReportSnapshot[]
}

/// 一個專案群組的週報分發訂閱:多久寄一次(排程設定在 SystemSettings,
/// 是全域的,這裡只有內容範圍)、寄給誰、寄哪些區塊。
///
/// 跟 WeeklyReport 是兩回事:WeeklyReport 是「一人一份、可以在週報頁面
/// 回看」的個人視角報告;這裡分發出去的報告不看任何人的權限(收件人可能
/// 是外部信箱,本來就沒有帳號),只寄信、不建可回看的紀錄。
model ProgramReportSubscription {
  id                 String                   @id @default(cuid())
  programId          String                   @unique
  program            Program                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// 「接下來幾天」的視窗長度——每個專案群組自己設,不是全域一個值。
  upcomingDays       Int                      @default(7)
  includeSummary     Boolean                  @default(true)
  includeProgramDiff Boolean                  @default(true)
  includeDepartments Boolean                  @default(true)
  includeActivity    Boolean                  @default(true)
  recipients         ProgramReportRecipient[]
  updatedAt          DateTime                 @updatedAt
}

/// 一個收件人。現有帳號填 userId(信箱跟著帳號走,改帳號信箱不用回來改
/// 這裡);系統外的人填 email。兩者互斥,不會同時有值。
model ProgramReportRecipient {
  id             String                    @id @default(cuid())
  subscriptionId String
  subscription   ProgramReportSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 自由填的外部信箱,userId 是 null 時才有值。
  email          String?

  @@unique([subscriptionId, userId])
}

/// 分發出去的專案週報,拿來跟下一週比對用的快照——跟 WeeklyReport 是同一個
///概念,但這份不是給人在「週報」頁面回看的,只是給「這一週 vs 上一週」的
/// diffWeeks 找上一份用,所以不掛使用者、不存 markdown、欄位比 WeeklyReport
/// 精簡。
model ProgramReportSnapshot {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  weekStart String
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([programId, weekStart])
}

/// 一份存下來的週報。
///
/// 存起來不只是為了有歷史可以翻:「這週完成了什麼」是拿這一份跟上一週那
/// 一份比出來的,沒有存檔就只能去解析活動紀錄那幾句中文再猜一次。
///
/// 一個人一週一份 —— 看得到哪些看板是跟著人走的,所以週報也是。
model WeeklyReport {
  id        String @id @default(cuid())
  /// ISO 週的週一,"YYYY-MM-DD"。
  weekStart String
  weekEnd   String
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 完整結構化內容,頁面跟下一週的比對都讀它。
  data      Json
  /// 產出當下排版好的 Markdown —— 之後改了排版,舊的那幾份仍然是當初寄出去的樣子。
  markdown  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

/// 一個透過動態註冊(RFC 7591)登記的 OAuth 用戶端。
///
/// MCP 的遠端連接器要求可以自己註冊 —— 沒有這一支,每接一個用戶端都得有
/// 人先到後台手動建一筆。註冊本身不代表任何權限:能拿到什麼,要等某個人
/// 在同意畫面上按下允許。
model OAuthClient {
  id           String   @id @default(cuid())
  /// 給用戶端的 client_id,對外可見。
  clientId     String   @unique
  /// 顯示在同意畫面上的名字,由用戶端自己申報,只是給人看的。
  name         String
  /// 授權碼只能送到這幾個網址,而且要完全相同。
  redirectUris String[]
  createdAt    DateTime @default(now())

  codes  OAuthCode[]
  tokens OAuthToken[]
}

/// 一次性的授權碼。
///
/// 存的是雜湊,而且活得很短 —— 它只需要活到用戶端把它換成權杖為止。
/// usedAt 有值就不能再換:攔到授權碼的人重放一次會被擋下來。
model OAuthCode {
  id            String      @id @default(cuid())
  hashedCode    String      @unique
  clientId      String
  client        OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 換權杖時要帶同一個,不同就拒絕。
  redirectUri   String
  codeChallenge String
  /// RFC 8707:這張授權碼是為了哪個資源發的。
  resource      String?
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime    @default(now())

  @@index([expiresAt])
}

/// 一張存取權杖(以及它的更新權杖)。
///
/// 跟 API 金鑰分開:這一張會過期、綁著某個用戶端、可以連人帶用戶端一起
/// 撤銷。兩者都存雜湊,所以外流的備份裡沒有能用的東西。
model OAuthToken {
  id                 String      @id @default(cuid())
  hashedAccessToken  String      @unique
  hashedRefreshToken String?     @unique
  clientId           String
  client             OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId             String
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource           String?
  expiresAt          DateTime
  refreshExpiresAt   DateTime?
  revokedAt          DateTime?
  lastUsedAt         DateTime?
  createdAt          DateTime    @default(now())

  @@index([userId])
  @@index([expiresAt])
}
