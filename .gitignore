# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# uploaded item attachments
/public/uploads/

# database backups (scripts/backup-db.sh) — real data, never commit
/backups/
/backup.sql

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production.example

# vercel
.vercel

# claude code local settings (machine-specific)
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts

# 週報產出物 —— 裡面有預算與人力,不進版控。
weekly-reports/

# TLS 私鑰材料(server.key、server.pfx 等)—— 只留在本機,不進 git 歷史。
/certs/

# 本機測試用的 port 覆蓋設定,每台機器自己決定要不要有——不進版控。
docker-compose.override.yml
